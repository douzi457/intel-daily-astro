{
  "name": "intel-daily-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy-local": "astro build && git add dist/ -f && git commit -m \"build: local deploy $(date +%Y-%m-%d)\" && git push",
