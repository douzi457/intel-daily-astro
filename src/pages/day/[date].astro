---
// 日报页 — 使用共享组件
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FocusSection from '../../components/FocusSection.astro';
import FeaturedSection from '../../components/FeaturedSection.astro';
import PlatformSection from '../../components/PlatformSection.astro';
import Sidebar from '../../components/Sidebar.astro';
import SectionNav from '../../components/SectionNav.astro';
import CalendarWidget from '../../components/CalendarWidget.astro';
import LayoutShell from '../../components/LayoutShell.astro';
import SiteNav from '../../components/SiteNav.astro';
import { getDayData, getAllDates } from '../../utils/data.ts';
import { SITE, SECTION_ORDER, getDow } from '../../lib/constants';
import type { FocusData, IntelItem, GzhArticle } from '../../lib/types';
import articles from '../../data/gzh-articles.json';

// ── 静态路径生成 ──
export async function getStaticPaths() {
  const dates = getAllDates('zh');
  return dates.map(d => ({ params: { date: d } }));
}

// ── 数据加载 ──
let focusData: FocusData | null = null;
try {
  const mod = await import('../../data/rewrite/today-focus.json');
  focusData = mod.default as FocusData;
} catch {}

const filteredArticles: GzhArticle[] = articles.filter((a: GzhArticle) => a.title);

const { date } = Astro.params as { date: string };
const dayData = getDayData(date, 'zh');
const items: IntelItem[] = dayData.items;
// v4.7：口径统一——用当日 dated 组计数（与首页时间线/“查看今日全部”同一口径），
// 不再用文件总数（文件可能含跨日期溢出，曾导致顶栏 899 与“查看今日全部”830 打架）；
// 无 dated 项时回落文件数。
const totalItems = items.filter((i) => (i.date || date) === date).length || items.length;

// ── 分组排序 ──
const grouped: Record<string, IntelItem[]> = {};
for (const item of items) {
  const key = item.platform || 'other';
  if (!grouped[key]) grouped[key] = [];
  grouped[key].push(item);
}
// v5：默认按时间——各平台组内按原文发布时间倒序（GitHub 组除外，组件内仍按今日 star 排）
for (const key of Object.keys(grouped)) {
  if (key === 'github') continue;
  grouped[key].sort((a, b) => String((b as any).published_at || '').localeCompare(String((a as any).published_at || '')));
}
// 事件数 vs 报道数：同一 topic 算一个事件，无 topic 的条目各算一个事件
const topicSet = new Set(items.map(i => ((i as any).topic || '').trim()).filter(Boolean));
const eventCount = topicSet.size + items.filter(i => !((i as any).topic || '').trim()).length;

const sortedAll = [...items].sort((a, b) => (b.score || 0) - (a.score || 0));
const featured = sortedAll.slice(0, 5);

const trending = [...items]
  .sort((a, b) => (b.hot || 0) - (a.hot || 0))
  .slice(0, 10);

const activeSections = SECTION_ORDER.filter(s => (grouped[s]?.length || 0) > 0);
const highScoreCount = items.filter(i => i.score >= 7).length;

// ── 导航 ──
const allDates = getAllDates('zh');
const idx = allDates.indexOf(date);
const prevDay = idx < allDates.length - 1 ? allDates[idx + 1] : null;
const nextDay = idx > 0 ? allDates[idx - 1] : null;
const recentDates = allDates.slice(0, 12);

// 动态 meta description（用当天第一精选）
const metaDesc = featured.length > 0
  ? `${date} 情报日报 · ${featured[0].title}`
  : `${date} 情报日报 · ${SITE.name} 每日情报`;

const pageUrl = `${SITE.url}/day/${date}`;
const prevUrl = prevDay ? `${SITE.url}/day/${prevDay}` : '';
const nextUrl = nextDay ? `${SITE.url}/day/${nextDay}` : '';
---

<BaseLayout
  title={`${date} 情报日报 · ${SITE.name}`}
  lang="zh-CN"
  description={metaDesc}
  ogImage={idx < 60 ? `/og/${date}.png` : '/og/default.png'}
  canonicalUrl={pageUrl}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
<div class="page">
  <div class="shell">
    <SiteNav active="day" today={allDates[0]} />
    <div class="page-head">
      <Header mode="day" date={date} totalItems={totalItems} />
    </div>
    <div class="shell-main">
      <!-- 日期导航 -->
      <div class="day-nav">
        {prevDay ? <a href={`/day/${prevDay}`} class="day-nav-link">← {prevDay}</a> : <span class="day-nav-spacer"></span>}
        <span class="day-nav-current">{date} {getDow(date, 'zh')}</span>
        {nextDay ? <a href={`/day/${nextDay}`} class="day-nav-link">{nextDay} →</a> : <span class="day-nav-spacer"></span>}
      </div>

      <!-- v5：事件数 vs 报道数 + 排序切换 + 仅搜本日报 -->
      <div class="day-toolbar">
        <span class="day-stats">{eventCount} 个事件 · {totalItems} 条报道 · {activeSections.length} 个来源</span>
        <span class="day-sort" role="group" aria-label="排序">
          <button type="button" class="sort-btn" data-sort="time">按时间</button>
          <button type="button" class="sort-btn" data-sort="value">按价值</button>
        </span>
      </div>
      <div class="day-search-row">
        <input type="search" id="daySearch" placeholder="仅搜本日报（标题 / 描述 / 来源）" aria-label="仅搜本日报" autocomplete="off" />
        <span class="search-count" id="daySearchCount"></span>
      </div>
      <div class="day-search-empty" id="daySearchEmpty"></div>

      <!-- v4.7：主内容移入 shell-main（此前在 shell 外的兄弟 .page 里，
           左栏 100vh 高把 shell 行撑到约 1018px，日报页顶部出现约 1000px 白空；
           另顺手修掉原来错配的 </div> / </aside> 标签） -->
      <div class="main-content">
        <PlatformSection grouped={grouped} locale="zh" date={date} />
        <FeaturedSection featured={featured} locale="zh" />

        <!-- 日历 -->
        {allDates.length > 0 && (
          <section class="section section-full">
            <CalendarWidget dates={allDates} basePath="/day/" locale="zh" currentDate={date} />
          </section>
        )}

        <!-- 赞助：内容之后的独立区域，明确标注，不进精选排名 -->
        {totalItems > 0 && (
          <div class="section" style="margin-bottom:0;">
            <div class="section-header">
              <div class="section-title" style="font-size:0.9em;">赞助</div>
            </div>
            <div class="news-list">
              <div class="news-item" style="--tag-color:#3395FF">
                <span class="news-idx" style="color:var(--accent);">赞助</span>
                <div class="news-body">
                  <a href="https://cloud.tencent.com/act/cps/redirect?redirect=6544&cps_key=c7ef87056c14c6dd880836c4671d0001&from=console" target="_blank" rel="sponsored noopener" class="news-title">腾讯云 AI 焕新季 · 2核2G4M 新客仅 99元/年</a>
                  <div class="news-footer">
                    <span class="platform-tag" style="--tag-color:#3395FF">腾讯云</span>
                    <span class="news-hot" style="color:var(--accent);">赞助</span>
                  </div>
                  <div class="news-desc">轻量应用服务器 4核4G3M 首年 79元，限时特惠中</div>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>

    <aside class="shell-right">
      <SectionNav activeSections={activeSections} locale="zh" />

      {/* 今日重点（仅当日匹配时显示） */}
      {focusData && focusData.date === date && (
        <FocusSection focusData={focusData} today={date} />
      )}

      <!-- 侧边栏（v4.7：从 content-grid 右列移入右栏，与首页结构对齐） -->
      <Sidebar
        totalItems={totalItems}
        activeSectionCount={activeSections.length}
        coverageDays={recentDates.length}
        highScoreCount={highScoreCount}
        grouped={grouped}
        featured={featured}
        trending={trending}
        filteredArticles={filteredArticles}
        locale="zh"
      />
    </aside>
  </div>

  <Footer />
</div>

<button id="backToTop" class="back-to-top" aria-label="回到顶部">↑</button>
</BaseLayout>

<style>
html { scroll-behavior: smooth; }

/* v4.7：Sidebar 移入右栏后——右栏本身已是滚动容器（≥1280px），
   取消 Sidebar 自带的 sticky；1024–1279px 段右栏是通栏块，
   沿用两列网格，避免单列拉满 */
@media (min-width: 1024px) {
  .shell-right :global(.sidebar) { position: static; }
}
@media (min-width: 1024px) and (max-width: 1279px) {
  .shell-right :global(.sidebar) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .shell-right :global(.sidebar .promo-block) { grid-column: 1 / -1; }
}

.main-content {
  display: flex;
  flex-direction: column;
  gap: 28px;
  min-width: 0;
}

.day-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 24px;
}

.day-nav-link {
  font-size: 0.85em;
  color: var(--text-m);
  padding: 6px 14px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.15s;
}

.day-nav-link:hover { border-color: var(--accent); color: var(--accent); }

.day-nav-current {
  font-size: 0.9em;
  font-weight: 700;
  color: var(--text-h);
  font-family: var(--font-mono);
}

/* v5：日报工具条——事件数 vs 报道数 + 排序切换 + 仅搜本日报 */
.day-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 12px;
  font-size: 13px;
  color: var(--text-m);
}
.day-stats { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.day-sort { display: inline-flex; border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; }
.sort-btn {
  height: 32px;
  padding: 0 12px;
  border: none;
  background: transparent;
  color: var(--text-p);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
}
.sort-btn[aria-pressed="true"] { background: var(--accent); color: var(--color-on-accent); }
.day-search-row { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
.day-search-row input[type="search"] {
  flex: 1;
  height: var(--size-element-lg);
  padding: 0 var(--spacing-3);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-background-surface);
  color: var(--color-text-primary);
  font-size: 13px;
}
.day-search-row input[type="search"]::placeholder { color: var(--ink-4); }
.day-search-row .search-count { font-size: 12px; color: var(--ink-4); white-space: nowrap; font-family: var(--font-mono); }
.day-search-empty { display: none; padding: var(--spacing-6) 0; text-align: center; font-size: 13px; color: var(--ink-4); }

.day-nav-spacer { width: 90px; }

.back-to-top {
  position: fixed;
  bottom: 32px;
  right: 32px;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--bg-card);
  color: var(--text-m);
  font-size: 1.2em;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(10px);
  transition: all 0.2s;
  z-index: 200;
  box-shadow: var(--shadow-md);
}

.back-to-top.visible { opacity: 1; transform: translateY(0); }
.back-to-top:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }

@media (max-width: 768px) {
  .back-to-top { bottom: 20px; right: 20px; width: 40px; height: 40px; }
  .day-nav-spacer { width: 50px; }
}
</style>

<script>
  // 搜索结果锚点：如果 hash 指向某条目，先展开“更多来源”再滚过去
  (function () {
    const m = location.hash.match(/^#entry-(\d+)$/);
    if (!m) return;
    const hs = document.getElementById('hiddenSources');
    const btn = document.getElementById('moreSourcesBtn');
    if (hs && !hs.classList.contains('visible')) {
      hs.classList.add('visible');
      if (btn) {
        btn.classList.add('expanded');
        if (btn.childNodes[0]) btn.childNodes[0].textContent = btn.getAttribute('data-show-less') || '收起';
      }
    }
    requestAnimationFrame(() => {
      document.getElementById(location.hash.slice(1))?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();

  const nav = document.getElementById('sectionNav');
  if (nav) {
    const links = nav.querySelectorAll('a[data-target]');
    const sections = Array.from(links).map(link => {
      const id = link.getAttribute('data-target');
      return id ? document.getElementById(id) : null;
    }).filter(Boolean) as HTMLElement[];

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          links.forEach(link => {
            link.classList.toggle('active', link.getAttribute('data-target') === id);
          });
        }
      });
    }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });

    sections.forEach(section => observer.observe(section));
  }

  const backBtn = document.getElementById('backToTop');
  if (backBtn) {
    window.addEventListener('scroll', () => {
      backBtn.classList.toggle('visible', window.scrollY > 400);
    });
    backBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }

  const promoEl = document.getElementById('tencentPromo') as HTMLAnchorElement | null;
  if (promoEl) {
    const promos = [
      { text: '💙 轻量服务器 4核4G3M 79元/年', href: 'https://cloud.tencent.com/act/cps/redirect?redirect=1079&cps_key=c7ef87056c14c6dd880836c4671d0001&from=console' },
      { text: '🤖 AI焕新季 2核2G4M 99元/年', href: 'https://cloud.tencent.com/act/cps/redirect?redirect=6544&cps_key=c7ef87056c14c6dd880836c4671d0001&from=console' },
      { text: '🎁 推广大使特惠合集', href: 'https://cloud.tencent.com/act/cps/redirect?redirect=2446&cps_key=c7ef87056c14c6dd880836c4671d0001&from=console' },
    ];
    let pi = 0;
    setInterval(() => {
      pi = (pi + 1) % promos.length;
      const p = promos[pi];
      promoEl.textContent = p.text;
      promoEl.href = p.href;
    }, 8000);
  }
</script>

<script>
  // v5：日报排序切换（默认按时间）+ 仅搜本日报；排序写进 URL，返回后保留
  (function () {
    const params = new URLSearchParams(location.search);
    let sortMode = params.get('sort') === 'value' ? 'value' : 'time';
    const sortBtns = Array.from(document.querySelectorAll('.sort-btn')) as HTMLButtonElement[];
    function renumber(list: HTMLElement) {
      list.querySelectorAll(':scope > .news-item[data-score] .news-idx').forEach((el, i) => {
        (el as HTMLElement).textContent = String(i + 1);
      });
    }
    function applySort() {
      sortBtns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.sort === sortMode)));
      document.querySelectorAll('.news-list').forEach(listEl => {
        const list = listEl as HTMLElement;
        // GitHub 组按今日 star 排，不参与切换；赞助卡片（无 data-score）也不参与
        if (list.closest('#section-github')) return;
        const items = Array.from(list.children).filter(el => el.classList.contains('news-item') && (el as HTMLElement).hasAttribute('data-score')) as HTMLElement[];
        items.sort((a, b) => {
          if (sortMode === 'value') return Number(b.dataset.score || 0) - Number(a.dataset.score || 0);
          return String(b.dataset.time || '').localeCompare(String(a.dataset.time || ''));
        });
        items.forEach(el => list.appendChild(el));
        renumber(list);
      });
    }
    sortBtns.forEach(b => b.addEventListener('click', () => {
      sortMode = (b.dataset.sort as 'time' | 'value') || 'time';
      const u = new URL(location.href);
      if (sortMode === 'value') u.searchParams.set('sort', 'value');
      else u.searchParams.delete('sort');
      history.replaceState(null, '', u.toString());
      applySort();
    }));
    applySort();

    // 仅搜本日报：只过滤已渲染条目，范围写明
    const input = document.getElementById('daySearch') as HTMLInputElement | null;
    const countEl = document.getElementById('daySearchCount');
    const emptyEl = document.getElementById('daySearchEmpty') as HTMLElement | null;
    const newsItems = Array.from(document.querySelectorAll('.news-item[data-score]')) as HTMLElement[];
    function applyDaySearch() {
      const q = (input?.value || '').trim().toLowerCase();
      let shown = 0;
      newsItems.forEach(el => {
        const ok = !q || (el.textContent || '').toLowerCase().includes(q);
        el.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      if (countEl) countEl.textContent = q ? `${shown} / ${newsItems.length}` : '';
      if (emptyEl) {
        emptyEl.style.display = (q && shown === 0) ? 'block' : 'none';
        if (q && shown === 0) emptyEl.textContent = `本日报内没有匹配「${input?.value.trim()}」的条目，换个词试试，或去全站搜索。`;
      }
    }
    input?.addEventListener('input', applyDaySearch);
  })();
</script>
