---
// 首页（v5，2026-11-20）：纸刊式情报台——先给判断，再给完整情报。
// H1「今日 AI 与科技情报」+ 一句用途；精选 5 个不同事件（topic 去重，宁缺毋滥）；
// 更多情报默认不重复精选事件；右栏只留「值得追踪」与往期回看，日历在归档。
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import LayoutShell from '../components/LayoutShell.astro';
import SiteNav from '../components/SiteNav.astro';
import { getDayData, getAllDates } from '../utils/data.ts';
import { SITE } from '../lib/constants';
import type { IntelItem, V4DailyData } from '../lib/types';

let v4Data: V4DailyData | null = null;
try {
  const v4Index = await import('../data/v4/index.json');
  const latestDate = v4Index.default.latest_date;
  if (latestDate) {
    const mod = await import(`../data/v4/daily-${latestDate}.json`);
    v4Data = mod.default as V4DailyData;
  }
} catch {}

const allDates = getAllDates('zh');
const today = allDates.length > 0 ? allDates[0] : new Date().toISOString().slice(0, 10);
const dayData = getDayData(today, 'zh');
const items: IntelItem[] = dayData.items;
const recentDates = allDates.slice(0, 10);

const groupedByDate = new Map<string, IntelItem[]>();
for (const item of items) {
  const d = item.date || today;
  if (!groupedByDate.has(d)) groupedByDate.set(d, []);
  groupedByDate.get(d)!.push(item);
}
const sortedDates = [...groupedByDate.keys()].sort().reverse();

// v4.7 口径：顶栏与“查看今日全部”用当日 dated 组；组为空才回落文件数，再回落 v4 总数。
const totalItems = groupedByDate.get(today)?.length || items.length || v4Data?.total_items || 0;

// 展示分（v4，2026-11-14）：有 ai_score 就用它——它是 80 条有摘要条目上
// 唯一有真实区分度的分数；没有 ai_score 才回落到 score。
// ai_score 量纲见 docs/scoring.md（0–10，五轴加权），前端只原样展示、不换算。
function displayScore(it: any): number {
  const a = (it as any).ai_score;
  return (typeof a === 'number' && !isNaN(a)) ? a : (it.score || 0);
}

// 高价值数：展示分 >= 7 的条目数
let highScoreCount = 0;
if (v4Data?.by_category) {
  for (const cat of Object.values(v4Data.by_category)) {
    for (const it of (cat as any[])) {
      if (displayScore(it) >= 7) highScoreCount++;
    }
  }
}

// 格式化时间（北京时间，只显示 HH:MM）
function fmtHM(iso?: string): string {
  if (!iso) return '';
  try {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    return d.toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', hour: '2-digit', minute: '2-digit', hour12: false });
  } catch { return ''; }
}

// 右栏热词 Top3（复用新词榜同一数据文件）
let hotTerms: any[] = [];
try {
  const nt = await import('../data/v4/new-terms-latest.json');
  const ts: any[] = (nt as any).default?.terms || [];
  hotTerms = [...ts].sort((a, b) => (b.max_score || 0) - (a.max_score || 0)).slice(0, 3);
} catch {}

const v4Date = v4Data?.date || today;
const y = v4Date.slice(0,4);
const m = parseInt(v4Date.slice(5,7)).toString();
const d = parseInt(v4Date.slice(8,10)).toString();
const displayDate = `${y}年${m}月${d}日`;

// 日报日期 vs 最近成功更新：generated_at 是管线写的北京时间，直接取 HH:MM，不做时区换算
const updatedHM = (v4Data as any)?.generated_at ? String((v4Data as any).generated_at).slice(11, 16) : '';
// 构建时的北京时间日期（构建机是 UTC，用 Asia/Shanghai 换算）
const nowBeijing = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Shanghai' });
const isStale = v4Date !== nowBeijing;

// 事件数 vs 报道数：同一 topic 算一个事件，无 topic 的条目各算一个事件
const todayItems = groupedByDate.get(today) || items;
const topicSet = new Set(todayItems.map(i => ((i as any).topic || '').trim()).filter(Boolean));
const eventCount = topicSet.size + todayItems.filter(i => !((i as any).topic || '').trim()).length;

// 精选 5 个不同事件：按展示分排，同一 topic 只留最高分，无 topic 的各算一个事件
const urlToId = new Map<string, number>();
for (const it of items) {
  if (it.url && typeof (it as any).id === 'number') urlToId.set(it.url, (it as any).id);
}
function dayAnchor(it: any): string {
  const id = urlToId.get(it.url);
  return id ? `/day/${v4Date}/#entry-${id}` : `/day/${v4Date}/`;
}
const featuredPool: any[] = [];
if (v4Data?.by_category) {
  for (const cat of Object.values(v4Data.by_category)) {
    for (const it of (cat as any[])) {
      if (it.ai_summary && String(it.ai_summary).trim()) featuredPool.push(it);
    }
  }
}
featuredPool.sort((a, b) => (displayScore(b) - displayScore(a)) || ((b.score || 0) - (a.score || 0)));
const seenTopics = new Set<string>();
const topFeatured: any[] = [];
for (const it of featuredPool) {
  const tp = String(it.topic || '').trim();
  if (tp && seenTopics.has(tp)) continue;
  if (tp) seenTopics.add(tp);
  topFeatured.push(it);
  if (topFeatured.length >= 5) break;
}
const featuredUrls = new Set(topFeatured.map(it => it.url));
---

<BaseLayout title="今日 AI 与科技情报 · 豆子实验室 · 每日情报" description="看清今天的关键变化，找到值得追踪的线索。每日精选 AI 与科技情报，带来源、可核对。" lang="zh-CN" ogImage="/og/today.png">
<style>
  /* token 见 src/styles/tokens.css（全站唯一来源） */
  body { background: var(--bg); color: var(--ink); font-family: 'Geist Sans', -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif; line-height: 1.65; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .page-wrap { max-width: 100%; margin: 0; padding: 0; }
  /* 标题区：紧凑，不做占半屏的宣传横幅 */
  .title-block { padding: var(--spacing-6) 0 var(--spacing-4); border-bottom: 1px solid var(--line); margin-bottom: var(--spacing-4); }
  .title-block h1 { font-size: clamp(26px, 4vw, 36px); font-weight: 800; color: var(--text-h); letter-spacing: var(--letter-spacing-tight); line-height: 1.25; }
  .title-block .subtitle { font-size: 15px; color: var(--text-p); margin-top: 8px; line-height: 1.65; }
  .title-block .dateline { font-size: 13px; color: var(--text-m); margin-top: 12px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .title-block .stats-line { font-size: 13px; color: var(--text-m); margin-top: 4px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .stale-notice { margin-top: 12px; padding: 10px 12px; border: 1px solid var(--border); border-left: 3px solid var(--color-warn); border-radius: var(--radius-md); background: var(--bg-card); font-size: 13px; color: var(--text-p); }
  /* 节标题 */
  .section-title { font-size: 18px; font-weight: 800; color: var(--color-text-primary); margin: var(--spacing-6) 0 var(--spacing-4); padding-bottom: var(--spacing-2); border-bottom: 1px solid var(--line); letter-spacing: var(--letter-spacing-tight); }
  .section-title .section-count { font-size: 13px; font-weight: 400; color: var(--color-text-secondary); margin-left: var(--spacing-2); font-family: var(--font-mono); }
  /* 精选：主卡（浅绿底 + 细绿边，只给当天主卡） */
  .featured-hero { background: var(--accent-soft); border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: var(--radius-lg); padding: var(--spacing-5); margin-bottom: var(--spacing-4); }
  .featured-tag { display: inline-block; font-size: 12px; font-weight: 700; color: var(--accent); margin-bottom: 8px; }
  .featured-hero h2 { font-size: clamp(22px, 3vw, 26px); font-weight: 800; line-height: 1.35; letter-spacing: var(--letter-spacing-tight); margin-bottom: 10px; }
  .featured-hero h2 a { color: var(--color-text-primary); text-decoration: none; }
  .featured-hero h2 a:hover { color: var(--accent); }
  .featured-summary { font-size: 15px; color: var(--text-p); line-height: 1.65; margin-bottom: 10px; }
  .featured-reason { font-size: 14px; color: var(--ink-2); line-height: 1.65; margin-bottom: 12px; }
  .featured-reason b { color: var(--ink-4); font-weight: 700; }
  .featured-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--ink-4); }
  .featured-meta .featured-time { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .featured-meta .featured-score { font-family: var(--font-mono); font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
  .featured-meta a.ext-link { color: var(--accent); text-decoration: none; font-weight: 600; white-space: nowrap; }
  .featured-meta a.ext-link:hover { text-decoration: underline; }
  /* 精选：2 张次卡 */
  .featured-subgrid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-4); margin-bottom: var(--spacing-4); }
  .featured-sub { background: var(--color-background-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-4); }
  .featured-sub h3 { font-size: 17px; font-weight: 700; color: var(--color-text-primary); line-height: 1.4; letter-spacing: var(--letter-spacing-tight); margin-bottom: 8px; }
  .featured-sub h3 a { color: inherit; text-decoration: none; }
  .featured-sub h3 a:hover { color: var(--accent); }
  .featured-sub .featured-summary { font-size: 14px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .featured-sub .featured-reason { font-size: 13px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  /* 精选：2 条紧凑精选 */
  .featured-compact { list-style: none; margin: 0 0 var(--spacing-4); padding: 0; }
  .featured-compact li { display: flex; align-items: baseline; gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .featured-compact li:last-child { border-bottom: none; }
  .featured-compact .rank { font-family: var(--font-mono); font-size: 15px; font-weight: 800; color: var(--accent); flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .featured-compact a.compact-title { font-size: 16px; font-weight: 600; color: var(--color-text-primary); text-decoration: none; line-height: 1.5; }
  .featured-compact a.compact-title:hover { color: var(--accent); }
  .featured-compact .compact-meta { font-size: 13px; color: var(--ink-4); white-space: nowrap; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  /* 更多情报：紧凑列表——标题 + 必要元信息，不为每条堆摘要、评分和标签 */
  .day-header { display: flex; align-items: center; gap: 10px; margin-bottom: var(--spacing-2); padding-bottom: var(--spacing-2); border-bottom: 1px solid var(--line); }
  .day-label { font-size: 11px; font-weight: 700; color: var(--ink-4); text-transform: uppercase; letter-spacing: .08em; white-space: nowrap; }
  .day-date { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); font-weight: 600; }
  .day-count { margin-left: auto; font-size: 11px; color: var(--color-text-tertiary); background: var(--paper); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 1px var(--spacing-2); }
  .entry { display: flex; align-items: baseline; gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .entry:last-child { border-bottom: none; }
  .entry-title { font-size: 16px; font-weight: 500; color: var(--color-text-primary); line-height: 1.5; letter-spacing: var(--letter-spacing-tight); text-decoration: none; flex: 1; min-width: 0; }
  .entry-title:hover { color: var(--accent); }
  .entry-meta { display: flex; align-items: center; gap: 8px; flex-shrink: 0; font-size: 13px; color: var(--ink-4); font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .entry-source { font-family: var(--font-sans); }
  .back-to-top { position: fixed; bottom: var(--spacing-8); right: var(--spacing-8); width: 44px; height: 44px; border-radius: var(--radius-lg); border: 1px solid var(--color-border); background: var(--color-background-surface); color: var(--color-text-secondary); font-size: 1.2em; cursor: pointer; display: flex; align-items: center; justify-content: center; opacity: 0; transform: translateY(10px); transition: all 0.2s; z-index: 200; box-shadow: var(--shadow-md); }
  .back-to-top.visible { opacity: 1; transform: translateY(0); }
  .back-to-top:hover { border-color: var(--accent); color: var(--accent); }
  /* 首页搜索：只搜今日已加载条目，不搜全库；与分类筛选叠加生效 */
  .search-row { display: flex; align-items: center; gap: 10px; margin: var(--spacing-4) 0 0; }
  .search-row input[type="search"] { flex: 1; min-width: 0; height: var(--size-element-lg); padding: 0 var(--spacing-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-background-surface); color: var(--color-text-primary); font-size: 13px; }
  .search-row input[type="search"]::placeholder { color: var(--ink-4); }
  .search-count { font-size: 12px; color: var(--ink-4); white-space: nowrap; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .search-all-link { font-size: 12px; color: var(--accent); white-space: nowrap; align-self: center; text-decoration: none; }
  .kbd-hint { font-size: 11px; color: var(--ink-4); margin: 0 0 var(--spacing-4); }
  .kbd-hint kbd { font-family: var(--font-mono); font-size: 10px; border: 1px solid var(--color-border); border-bottom-width: 2px; border-radius: 4px; padding: 0 4px; background: var(--bg-card); }
  .load-more-btn { display: block; width: 100%; margin: var(--spacing-4) 0; padding: 10px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--bg-card); color: var(--ink); font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; }
  .load-more-btn:hover { border-color: var(--accent); color: var(--accent); }
  .load-more-btn:disabled { opacity: .5; cursor: default; }
  .search-empty { display: none; padding: var(--spacing-6) 0; text-align: center; font-size: 13px; color: var(--ink-4); }
  /* 右栏收起：只在宽屏生效，窄屏右栏本来就是隐藏的 */
  .rail-toggle { display: none; width: 100%; height: var(--size-element-md); margin-bottom: var(--spacing-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: transparent; color: var(--ink-3); font-size: 12px; font-weight: 600; cursor: pointer; }
  .rail-toggle:hover { color: var(--color-text-primary); border-color: var(--ink-4); }
  .rail-expand { display: none; position: fixed; right: 0; top: 50%; transform: translateY(-50%); z-index: 150; height: var(--size-element-lg); padding: 0 var(--spacing-2); border: 1px solid var(--color-border); border-right: none; border-radius: var(--radius-md) 0 0 var(--radius-md); background: var(--color-background-surface); color: var(--ink-3); font-size: 12px; font-weight: 600; cursor: pointer; }
  @media (min-width: 1280px) {
    .rail-toggle { display: block; }
    body.rail-collapsed .rail-expand { display: block; }
  }
  /* 分类筛选 */
  .cat-filter { display: flex; gap: var(--spacing-1); margin: var(--spacing-4) 0 var(--spacing-5); padding: 0; background: transparent; border-bottom: 1px solid var(--color-border); overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; -webkit-mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 48px), transparent 100%); mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 48px), transparent 100%); }
  .cat-filter.at-end { -webkit-mask-image: none; mask-image: none; }
  .cat-filter::-webkit-scrollbar { display: none; }
  .cat-pill { flex-shrink: 0; height: var(--size-element-lg); padding: 0 var(--spacing-3); border: none; border-bottom: 2px solid transparent; margin-bottom: -1px; border-radius: 0; background: transparent; color: var(--color-text-secondary); font-size: 13px; font-weight: 600; cursor: pointer; transition: color 0.15s, border-color 0.15s; white-space: nowrap; }
  .cat-pill.active { background: transparent; color: var(--color-accent); border-bottom-color: var(--color-accent); box-shadow: none; }
  .cat-pill:hover { color: var(--color-text-primary); }
  .rail-terms a.rail-term { color: var(--ink); text-decoration: none; }
  .rail-terms a.rail-term:hover { color: var(--accent); }
  .hidden { display: none !important; }
  @media (max-width: 640px) {
    .page-wrap { padding: 0 0 40px; }
    .featured-subgrid { grid-template-columns: 1fr; }
    .featured-compact .compact-meta { display: none; }
    .entry { flex-wrap: wrap; gap: 4px; }
    .entry-title { font-size: 15px; flex-basis: 100%; }
    .back-to-top { bottom: 20px; right: 20px; width: 40px; height: 40px; }
  }
</style>

<div class="page-wrap">
  <div class="shell">
    <SiteNav active="home" today={today} />
    <div class="shell-main">
      <div class="title-block">
        <h1>今日 AI 与科技情报</h1>
        <p class="subtitle">看清今天的关键变化，找到值得追踪的线索</p>
        <p class="dateline">{displayDate} · 日报 {v4Date}{updatedHM && ` · 最近成功更新 ${updatedHM}`}</p>
        {isStale && <p class="stale-notice">今日尚未更新，以下为 {v4Date} 日报。</p>}
        <p class="stats-line">今日情报 {totalItems} 条（{eventCount} 个事件） · {v4Data?.total_sources || '—'} 个来源 · 高价值信号 {highScoreCount} 个</p>
      </div>

      {/* 首页搜索：只搜今日已加载条目，不搜全库；与分类筛选叠加生效 */}
      <div class="search-row">
        <input type="search" id="homeSearch" placeholder="仅搜今日已加载条目（标题 / 摘要 / 来源）" aria-label="搜索今日情报" autocomplete="off" />
        <span class="search-count" id="searchCount"></span>
        <a class="search-all-link" href="/search/">搜全站 →</a>
      </div>
      <div class="search-empty" id="searchEmpty">没有匹配的条目，换个词试试。</div>
      <div class="kbd-hint">快捷键：<kbd>/</kbd> 搜索 · <kbd>j</kbd> / <kbd>k</kbd> 移动条目 · <kbd>回车</kbd> 打开当前条目</div>
      {/* 分类筛选 */}
      {v4Data?.by_category && (
        <div class="cat-filter" id="catFilter">
          <button class="cat-pill active" data-cat="all">全部情报</button>
          {Object.keys(v4Data.by_category).map((cat) => (
            <button class="cat-pill" data-cat={cat}>{cat}</button>
          ))}
        </div>
      )}

      <script>
        const catFilter = document.getElementById('catFilter');
        if (catFilter) {
          catFilter.addEventListener('click', (e: Event) => {
            const btn = (e.target as HTMLElement).closest('.cat-pill') as HTMLElement | null;
            if (!btn) return;
            const cat = btn.dataset.cat || 'all';
            catFilter.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.querySelectorAll('.entry-item').forEach(el => {
              if (cat === 'all') {
                el.classList.remove('hidden');
              } else {
                el.classList.toggle('hidden', (el as HTMLElement).dataset.category !== cat);
              }
            });
          });
        }
      </script>

      {topFeatured.length > 0 && (
        <>
          <h2 class="section-title">今日精选 <span class="section-count">{topFeatured.length} 个事件</span></h2>
          {(() => {
            const hero = topFeatured[0];
            const hs = displayScore(hero);
            const hAnchor = dayAnchor(hero);
            return (
              <article class="featured-hero">
                {(hero.topic || hero.content_type_label) && <span class="featured-tag">{hero.topic || hero.content_type_label}</span>}
                <h2><a href={hAnchor}>{hero.ai_title || hero.title}</a></h2>
                <p class="featured-summary">{hero.ai_summary}</p>
                {hero.ai_reason && (<p class="featured-reason"><b>为什么值得关注：</b>{hero.ai_reason}</p>)}
                <div class="featured-meta">
                  <span>{hero.source}</span>
                  {fmtHM(hero.published_at) && <span class="featured-time">{fmtHM(hero.published_at)}</span>}
                  {(hero.source_count || 0) > 1 && <span>{hero.source_count} 家报道</span>}
                  <span class="featured-score">{hs.toFixed(1)}</span>
                  <a class="ext-link" href={hero.url} target="_blank" rel="noopener">查看原文 ↗</a>
                  <button class="fav-btn" type="button" data-fav-id={`${v4Date}:${urlToId.get(hero.url) || hero.url}`} data-fav-title={hero.ai_title || hero.title} data-fav-date={v4Date} data-fav-url={hAnchor} data-fav-score={hs} aria-label="收藏">☆</button>
                </div>
              </article>
            );
          })()}
          {topFeatured.length > 1 && (
            <div class="featured-subgrid">
              {topFeatured.slice(1, 3).map((item: any, i: number) => {
                const s = displayScore(item);
                const anchor = dayAnchor(item);
                return (
                  <article class="featured-sub" key={i}>
                    {(item.topic || item.content_type_label) && <span class="featured-tag">{item.topic || item.content_type_label}</span>}
                    <h3><a href={anchor}>{item.ai_title || item.title}</a></h3>
                    <p class="featured-summary">{item.ai_summary}</p>
                    {item.ai_reason && (<p class="featured-reason"><b>为什么值得关注：</b>{item.ai_reason}</p>)}
                    <div class="featured-meta">
                      <span>{item.source}</span>
                      {fmtHM(item.published_at) && <span class="featured-time">{fmtHM(item.published_at)}</span>}
                      {(item.source_count || 0) > 1 && <span>{item.source_count} 家报道</span>}
                      <span class="featured-score">{s.toFixed(1)}</span>
                      <a class="ext-link" href={item.url} target="_blank" rel="noopener">查看原文 ↗</a>
                      <button class="fav-btn" type="button" data-fav-id={`${v4Date}:${urlToId.get(item.url) || item.url}`} data-fav-title={item.ai_title || item.title} data-fav-date={v4Date} data-fav-url={anchor} data-fav-score={s} aria-label="收藏">☆</button>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
          {topFeatured.length > 3 && (
            <ol class="featured-compact">
              {topFeatured.slice(3, 5).map((item: any, i: number) => {
                const s = displayScore(item);
                return (
                  <li key={i}>
                    <span class="rank">{i + 4}</span>
                    <a class="compact-title" href={dayAnchor(item)}>{item.ai_title || item.title}</a>
                    <span class="compact-meta">{item.source}{fmtHM(item.published_at) ? ` · ${fmtHM(item.published_at)}` : ''} · {s.toFixed(1)}</span>
                  </li>
                );
              })}
            </ol>
          )}
          <a class="more-link" href={`/day/${v4Date}/`}>查看完整日报 →</a>
        </>
      )}

      <h2 class="section-title">更多情报</h2>
      <div class="timeline-wrap">
        {sortedDates.map(dateStr => {
          const dayItems = groupedByDate.get(dateStr) || [];
          const sorted = [...dayItems].sort((a, b) => (b.score || 0) - (a.score || 0));
          if (dateStr !== today) return null;
          const dy = dateStr.slice(0,4), dm = dateStr.slice(5,7), dd = dateStr.slice(8,10);
          const dayLabel = dateStr === today ? '今天' : `${dm}月${dd}日`;
          // 更多情报默认不重复精选事件
          const rest = sorted.filter(it => !featuredUrls.has(it.url));
          return (
            <section>
              <div class="day-header">
                <span class="day-label">{dayLabel}</span>
                <span class="day-date">{dy}-{dm}-{dd}</span>
                <span class="day-count">{rest.length} 条</span>
              </div>
              {rest.slice(0, 30).map(item => {
                const timeStr = fmtHM((item as any).published_at);
                const platform = item.platform_label || item.source || '';
                const displayTitle = item.ai_title || item.title;
                return (
                  <article class="entry entry-item" id={`entry-${item.id}`} data-category={item.category || '其他'}>
                    <a href={item.url || '#'} target="_blank" rel="noopener" class="entry-title">{displayTitle}</a>
                    <div class="entry-meta">
                      {timeStr && <span class="entry-time">{timeStr}</span>}
                      {platform && <span class="entry-source">{platform}</span>}
                      {(item as any).source_count > 1 && <span>{(item as any).source_count} 家报道</span>}
                      <button class="fav-btn" type="button" data-fav-id={`${dateStr}:${item.id}`} data-fav-title={displayTitle} data-fav-date={dateStr} data-fav-url={`/day/${dateStr}/#entry-${item.id}`} data-fav-score={displayScore(item)} aria-label="收藏">☆</button>
                    </div>
                  </article>
                );
              })}
              {rest.length > 30 && (<button class="load-more-btn" id="loadMoreBtn" type="button">加载更多（还剩 {rest.length - 30} 条）</button>)}
              {rest.length > 30 && (<a class="more-link" href={`/day/${dateStr}/`}>查看今日全部 {sorted.length} 条 →</a>)}
            </section>
          );
        })}
      </div>
    </div>

    <aside class="shell-right">
      <button class="rail-toggle" id="railCollapse" aria-label="收起右侧栏">收起右侧栏 →</button>
      {hotTerms.length > 0 && (
        <section class="rail-card">
          <div class="rail-title">值得追踪 <a href="/new-terms/" class="rail-more">全部 →</a></div>
          <ul class="rail-terms">
            {hotTerms.map((t: any) => (
              <li><a class="rail-term" href={`/search/?q=${encodeURIComponent(t.term)}`}>{t.term}</a><span class="rail-count">今日 {t.today_count || 0} 篇 · 最高 {Number(t.max_score || 0).toFixed(1)}</span></li>
            ))}
          </ul>
        </section>
      )}
      <section class="rail-card">
        <div class="rail-title">往期回看</div>
        <ul class="rail-terms">
          {recentDates.slice(1, 4).map((dstr: string) => (
            <li><a class="rail-term" href={`/day/${dstr}/`}>{dstr}</a><span class="rail-count">日报 →</span></li>
          ))}
        </ul>
        <div style="margin-top: 10px;"><a href="/archive" class="rail-more">历史归档 →</a></div>
      </section>
    </aside>

  </div>
  <Footer />
</div>
<button class="rail-expand" id="railExpand" aria-label="展开右侧栏">← 展开</button>
<button id="backToTop" class="back-to-top" aria-label="回到顶部">↑</button>
<script>
  const backBtn = document.getElementById('backToTop');
  if (backBtn) {
    window.addEventListener('scroll', () => { backBtn.classList.toggle('visible', window.scrollY > 300); });
    backBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }
  // 首页搜索 + 分类叠加过滤：只动今日已渲染的条目
  const searchInput = document.getElementById('homeSearch') as HTMLInputElement | null;
  const searchCount = document.getElementById('searchCount');
  const searchEmpty = document.getElementById('searchEmpty');
  let entryItems = Array.from(document.querySelectorAll('.entry-item')) as HTMLElement[];
  let activeCat = 'all';
  function applyHomeFilters() {
    const q = (searchInput?.value || '').trim().toLowerCase();
    let shown = 0;
    entryItems.forEach(el => {
      const catOk = activeCat === 'all' || el.dataset.category === activeCat;
      const qOk = !q || (el.textContent || '').toLowerCase().includes(q);
      const vis = catOk && qOk;
      el.classList.toggle('hidden', !vis);
      if (vis) shown++;
    });
    if (searchCount) searchCount.textContent = q ? `${shown} / ${entryItems.length}` : '';
    if (searchEmpty) searchEmpty.style.display = (q && shown === 0) ? 'block' : 'none';
  }
  searchInput?.addEventListener('input', applyHomeFilters);
  document.querySelectorAll('#catFilter .cat-pill').forEach(btn => {
    btn.addEventListener('click', () => { activeCat = (btn as HTMLElement).dataset.cat || 'all'; applyHomeFilters(); });
  });
  // 分类标签行右侧渐隐：滑到头就取消渐隐；一行放得下时也不渐隐
  const catFilter = document.getElementById('catFilter');
  function syncCatFade() {
    if (!catFilter) return;
    catFilter.classList.toggle('at-end', catFilter.scrollLeft + catFilter.clientWidth >= catFilter.scrollWidth - 2);
  }
  catFilter?.addEventListener('scroll', syncCatFade, { passive: true });
  window.addEventListener('resize', syncCatFade);
  syncCatFade();
  // 加载更多：从构建时生成的当日余量 JSON 取下 30 条拼上去（与首页同排序：score 倒序）
  const loadMoreBtn = document.getElementById('loadMoreBtn') as HTMLButtonElement | null;
  let moreItems: any[] | null = null;
  let moreShown = 0;
  function escHtml(s: any): string {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function fmtHMClient(iso?: string): string {
    if (!iso) return '';
    try {
      const d = new Date(iso);
      if (isNaN(d.getTime())) return '';
      return d.toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', hour: '2-digit', minute: '2-digit', hour12: false });
    } catch { return ''; }
  }
  function moreEntryHtml(it: any, dateStr: string): string {
    // v5 紧凑列表：标题 + 必要元信息
    const timeStr = fmtHMClient(it.tm);
    const srcHtml = it.sc > 1 ? `<span>${it.sc} 家报道</span>` : '';
    return `<article class="entry entry-item" id="entry-${it.id}" data-category="${escHtml(it.c || '其他')}"><a href="${escHtml(it.u || '#')}" target="_blank" rel="noopener" class="entry-title">${escHtml(it.t)}</a><div class="entry-meta">${timeStr ? `<span class="entry-time">${timeStr}</span>` : ''}${it.p ? `<span class="entry-source">${escHtml(it.p)}</span>` : ''}${srcHtml}<button class="fav-btn" type="button" data-fav-id="${dateStr}:${it.id}" data-fav-title="${escHtml(it.t)}" data-fav-date="${dateStr}" data-fav-url="/day/${dateStr}/#entry-${it.id}" data-fav-score="${it.s || 0}" aria-label="收藏">☆</button></div></article>`;
  }
  loadMoreBtn?.addEventListener('click', async () => {
    if (!loadMoreBtn) return;
    loadMoreBtn.disabled = true;
    loadMoreBtn.textContent = '加载中…';
    try {
      if (!moreItems) {
        const r = await fetch('/more-today.json');
        const j = await r.json();
        moreItems = j.items || [];
      }
      const timeline = document.querySelector('.timeline-wrap section');
      const batch = (moreItems || []).slice(moreShown, moreShown + 30);
      const dateStr = document.querySelector('.day-date')?.textContent?.trim() || '';
      const html = batch.map(it => moreEntryHtml(it, dateStr)).join('');
      const frag = document.createElement('div');
      frag.innerHTML = html;
      const moreLink = document.querySelector('.more-link');
      while (frag.firstChild) timeline?.insertBefore(frag.firstChild, moreLink || null);
      moreShown += batch.length;
      entryItems = Array.from(document.querySelectorAll('.entry-item')) as HTMLElement[];
      applyHomeFilters();
      (window as any).__dailyFavRefresh?.();
      const remain = (moreItems?.length || 0) - moreShown;
      if (remain <= 0) {
        loadMoreBtn.style.display = 'none';
      } else {
        loadMoreBtn.disabled = false;
        loadMoreBtn.textContent = `加载更多（还剩 ${remain} 条）`;
      }
    } catch {
      loadMoreBtn.disabled = false;
      loadMoreBtn.textContent = '加载失败，点我重试';
    }
  });
  // 右栏收起：宽屏才有右栏，选了就记住
  const railKey = 'daily-rail-collapsed';
  if (localStorage.getItem(railKey) === '1') document.body.classList.add('rail-collapsed');
  document.getElementById('railCollapse')?.addEventListener('click', () => {
    document.body.classList.add('rail-collapsed');
    localStorage.setItem(railKey, '1');
  });
  document.getElementById('railExpand')?.addEventListener('click', () => {
    document.body.classList.remove('rail-collapsed');
    localStorage.setItem(railKey, '0');
  });
</script>
</BaseLayout>
