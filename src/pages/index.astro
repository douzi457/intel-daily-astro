---
// 首页 — Astryx v2（2026-11-10）：按 Astryx neutral 主题整套布局与配色，不再用 AIHOT 样式，见下方 <style> 注释
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CalendarWidget from '../components/CalendarWidget.astro';
import LayoutShell from '../components/LayoutShell.astro';
import SiteNav from '../components/SiteNav.astro';
import { getDayData, getAllDates } from '../utils/data.ts';
import { SITE } from '../lib/constants';
import type { IntelItem, V4DailyData } from '../lib/types';

let v4Data: V4DailyData | null = null;
try {
  const v4Index = await import('../data/v4/index.json');
  const latestDate = v4Index.default.latest_date;
  if (latestDate) {
    const mod = await import(`../data/v4/daily-${latestDate}.json`);
    v4Data = mod.default as V4DailyData;
  }
} catch {}

const allDates = getAllDates('zh');
const today = allDates.length > 0 ? allDates[0] : new Date().toISOString().slice(0, 10);
const dayData = getDayData(today, 'zh');
const items: IntelItem[] = dayData.items;
// 今日情报统一用 v4 的 total_items（更准确）
// v4.1：顶栏与统计条的“今日情报”与时间线用同一个数（当日已渲染列表），
// 不再用 v4 总数，避免 899 与 830 打架；列表为空时才回落到 v4 总数。
const totalItems = items.length || v4Data?.total_items || 0;
const recentDates = allDates.slice(0, 10);

const groupedByDate = new Map<string, IntelItem[]>();
for (const item of items) {
  const d = item.date || today;
  if (!groupedByDate.has(d)) groupedByDate.set(d, []);
  groupedByDate.get(d)!.push(item);
}
const sortedDates = [...groupedByDate.keys()].sort().reverse();

// 展示分（v4，2026-11-14）：有 ai_score 就用它——它是 80 条有摘要条目上
// 唯一有真实区分度的分数（本文件：1.0–7.5）；没有 ai_score 才回落到 score。
// ai_score 的量纲管线侧尚未书面确认（看起来像 0-10），前端只原样展示、不换算。
function displayScore(it: any): number {
  const a = (it as any).ai_score;
  return (typeof a === 'number' && !isNaN(a)) ? a : (it.score || 0);
}

// 高价值数与热点榜统一口径：展示分 >= 7 的条目数
let highScoreCount = 0;
if (v4Data?.by_category) {
  for (const cat of Object.values(v4Data.by_category)) {
    for (const it of (cat as any[])) {
      if (displayScore(it) >= 7) highScoreCount++;
    }
  }
}

// 格式化时间（北京时间，只显示 HH:MM）
function fmtHM(iso?: string): string {
  if (!iso) return '';
  try {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    return d.toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', hour: '2-digit', minute: '2-digit', hour12: false });
  } catch { return ''; }
}

// 右栏热词 Top5（复用新词榜同一数据文件）
let hotTerms: any[] = [];
try {
  const nt = await import('../data/v4/new-terms-latest.json');
  const ts: any[] = (nt as any).default?.terms || [];
  hotTerms = [...ts].sort((a, b) => (b.max_score || 0) - (a.max_score || 0)).slice(0, 5);
} catch {}

const v4Date = v4Data?.date || today;
const y = v4Date.slice(0,4);
const m = parseInt(v4Date.slice(5,7)).toString();
const d = parseInt(v4Date.slice(8,10)).toString();
const displayDate = `${y}年${m}月${d}日`;

function gradeBadge(score: number): string {
  if (score >= 8) return 'elite';
  if (score >= 6) return 'high';
  return 'normal';
}
function gradeLabel(score: number): string {
  if (score >= 8) return '高价值';
  if (score >= 6) return '中价值';
  return '普通';
}
function reasonText(score: number): string {
  return '';
}
---

<BaseLayout title={`${displayDate} AI/科技情报`} description={`${displayDate} 全球科技资讯聚合，AI智能评分精选`} lang="zh-CN">
<style>
  /* token 见 src/styles/tokens.css（全站唯一来源） */
  body { background: var(--bg); color: var(--ink); font-family: 'Geist Sans', -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .page-wrap { max-width: 100%; margin: 0; padding: 0; }
  .stats-bar { display: flex; align-items: center; justify-content: center; gap: 0; padding: var(--spacing-4) var(--spacing-5); margin: var(--spacing-5) 0 28px; background: var(--color-background-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); box-shadow: var(--shadow-sm); font-size: 13px; }
  .stats-bar-item { text-align: center; padding: 0 var(--spacing-6); }
  .stats-bar-value { display: block; font-family: var(--font-mono); font-size: 1.3em; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
  .stats-bar-label { display: block; font-size: 0.85em; color: var(--ink-3); margin-top: 2px; }
  .stats-bar-item.highlight .stats-bar-value { color: var(--accent); }
  .stats-bar-divider { width: 1px; height: 28px; background: var(--border); }
  .timeline-wrap { display: flex; flex-direction: column; gap: var(--spacing-8); }
  .day-header { display: flex; align-items: center; gap: 10px; margin-bottom: var(--spacing-4); padding-bottom: var(--spacing-2); border-bottom: 1px solid var(--line); }
  .day-label { font-size: 11px; font-weight: 700; color: var(--ink-4); text-transform: uppercase; letter-spacing: .08em; white-space: nowrap; }
  .day-date { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); font-weight: 600; }
  .day-count { margin-left: auto; font-size: 11px; color: var(--color-text-tertiary); background: var(--paper); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 1px var(--spacing-2); }
  .entry { padding: var(--spacing-4) 0; border-bottom: 1px solid var(--line); }
  .entry:last-child { border-bottom: none; }
  .entry:hover { background: var(--paper); margin: 0 calc(var(--spacing-2) * -1); padding-left: var(--spacing-2); padding-right: var(--spacing-2); border-radius: var(--radius-sm); }
  .entry-meta { display: flex; align-items: center; gap: var(--spacing-1-5); flex-wrap: wrap; margin-bottom: var(--spacing-1-5); }
  .entry-time { font-family: var(--font-mono); font-size: 11px; color: var(--ink-4); font-variant-numeric: tabular-nums; }
  .entry-sep { color: var(--ink-4); font-size: 11px; }
  .entry-source { font-size: 11px; color: var(--ink-3); font-weight: 500; }
  /* Astryx Badge：两类徽章统一为同一高度/内边距/圆角，只换颜色 */
  .grade-pill { display: inline-flex; align-items: center; padding: var(--spacing-0-5) var(--spacing-2); border-radius: var(--radius-xs); font-size: 10px; font-weight: 700; border: 1px solid transparent; }
  /* v4：标签色收敛——只有高价值用暖橙，其余走中性灰；评分数字走等宽字体 */
  .grade-elite { background: var(--accent-soft); color: var(--accent); border-color: transparent; }
  .grade-high { background: var(--paper); color: var(--ink-3); border-color: var(--color-border); }
  .grade-normal { background: transparent; color: var(--ink-4); border-color: var(--color-border); }
  .entry-title { font-size: var(--text-base); font-weight: 500; color: var(--color-text-primary); line-height: 1.5; letter-spacing: var(--letter-spacing-tight); margin-bottom: 7px; display: block; text-decoration: none; }
  .entry-title:hover { color: var(--accent); }
  .entry-summary { font-size: 13px; color: var(--ink-3); line-height: 1.6; margin-bottom: 7px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .entry-reason { font-size: 12px; color: var(--ink-2); line-height: 1.55; padding-left: 10px; border-left: 2px solid var(--border); }
  .entry-reason-label { font-weight: 700; color: var(--ink-4); margin-right: 4px; }
  .ai-score-badge { display: inline-flex; align-items: center; padding: var(--spacing-0-5) var(--spacing-2); border-radius: var(--radius-xs); font-size: 10px; font-weight: 700; font-family: var(--font-mono); font-variant-numeric: tabular-nums; border: 1px solid var(--color-border); background: transparent; color: var(--ink-3); margin-left: var(--spacing-1); }
  .back-to-top { position: fixed; bottom: var(--spacing-8); right: var(--spacing-8); width: 44px; height: 44px; border-radius: var(--radius-lg); border: 1px solid var(--color-border); background: var(--color-background-surface); color: var(--color-text-secondary); font-size: 1.2em; cursor: pointer; display: flex; align-items: center; justify-content: center; opacity: 0; transform: translateY(10px); transition: all 0.2s; z-index: 200; box-shadow: var(--shadow-md); }
  .back-to-top.visible { opacity: 1; transform: translateY(0); }
  .back-to-top:hover { border-color: var(--accent); color: var(--accent); }
  /* 精选区样式 */
  .featured-title { font-size: 1.1em; font-weight: 700; color: var(--color-text-primary); margin: var(--spacing-6) 0 var(--spacing-3); padding-bottom: var(--spacing-2); border-bottom: 1px solid var(--line); letter-spacing: var(--letter-spacing-tight); }
  .featured-count { font-size: 0.85em; font-weight: 400; color: var(--color-text-secondary); margin-left: var(--spacing-2); }
  .featured-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--spacing-4); margin-bottom: var(--spacing-6); }
  .featured-card { background: var(--color-background-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--spacing-4); transition: border-color 0.15s; }
  .featured-card:hover { border-color: var(--ink-4); }
  .featured-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .featured-rank { font-family: var(--font-mono); font-size: 20px; font-weight: 800; color: var(--accent); line-height: 1; font-variant-numeric: tabular-nums; }
  .featured-score { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
  .featured-score-num { font-family: var(--font-mono); font-size: 15px; font-weight: 800; color: var(--color-text-primary); font-variant-numeric: tabular-nums; line-height: 1; }
  .featured-score-bar { display: block; width: 64px; height: 3px; border-radius: 9999px; background: var(--color-border); overflow: hidden; }
  .featured-score-bar span { display: block; height: 100%; background: var(--accent); border-radius: 9999px; }
  .featured-card h3 { font-size: var(--text-sm); font-weight: 700; color: var(--color-text-primary); line-height: 1.4; letter-spacing: var(--letter-spacing-tight); margin: var(--spacing-1-5) 0; }
  .featured-card h3 a { color: inherit; text-decoration: none; }
  .featured-card h3 a:hover { color: var(--accent); }
  .featured-summary { font-size: 12px; color: var(--ink-3); line-height: 1.6; margin-bottom: 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .featured-reason { font-size: 12px; color: var(--ink-2); line-height: 1.55; margin-bottom: 8px; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; cursor: pointer; }
  .featured-reason.expanded { display: block; }
  .featured-reason::before { content: '推荐理由：'; font-weight: 700; color: var(--ink-4); }
  .featured-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 11px; color: var(--ink-4); }
  .featured-meta .featured-time { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  /* 情报流标题：精选与流明确分离 */
  .stream-title { font-size: 1.1em; font-weight: 700; color: var(--color-text-primary); margin: var(--spacing-6) 0 var(--spacing-3); padding-bottom: var(--spacing-2); border-bottom: 1px solid var(--line); letter-spacing: var(--letter-spacing-tight); }
  /* 首页搜索：只搜今日已渲染的 30 条（标题 / 摘要 / 来源），不搜全库 */
  .search-row { display: flex; align-items: center; gap: 10px; margin: var(--spacing-4) 0 0; }
  .search-row input[type="search"] { flex: 1; height: var(--size-element-lg); padding: 0 var(--spacing-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-background-surface); color: var(--color-text-primary); font-size: 13px; }
  .search-row input[type="search"]::placeholder { color: var(--ink-4); }
  .search-count { font-size: 12px; color: var(--ink-4); white-space: nowrap; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .search-all-link { font-size: 12px; color: var(--accent); white-space: nowrap; align-self: center; text-decoration: none; }
  .search-empty { display: none; padding: var(--spacing-6) 0; text-align: center; font-size: 13px; color: var(--ink-4); }
  /* 右栏收起：只在宽屏生效，窄屏右栏本来就是隐藏的 */
  .rail-toggle { display: none; width: 100%; height: var(--size-element-md); margin-bottom: var(--spacing-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: transparent; color: var(--ink-3); font-size: 12px; font-weight: 600; cursor: pointer; }
  .rail-toggle:hover { color: var(--color-text-primary); border-color: var(--ink-4); }
  .rail-expand { display: none; position: fixed; right: 0; top: 50%; transform: translateY(-50%); z-index: 150; height: var(--size-element-lg); padding: 0 var(--spacing-2); border: 1px solid var(--color-border); border-right: none; border-radius: var(--radius-md) 0 0 var(--radius-md); background: var(--color-background-surface); color: var(--ink-3); font-size: 12px; font-weight: 600; cursor: pointer; }
  @media (min-width: 1280px) {
    .rail-toggle { display: block; }
    body.rail-collapsed .rail-expand { display: block; }
  }
  /* 分类筛选 */
  /* Astryx Tabs（v3）：分类是一排文字标签，不是药丸；当前项只用一条强调色下划线，不再用灰底整条 */
  .cat-filter { display: flex; gap: var(--spacing-1); margin: var(--spacing-4) 0 var(--spacing-5); padding: 0; background: transparent; border-bottom: 1px solid var(--color-border); overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; -webkit-mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 48px), transparent 100%); mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 48px), transparent 100%); }
  .cat-filter.at-end { -webkit-mask-image: none; mask-image: none; }
  .cat-filter::-webkit-scrollbar { display: none; }
  .cat-pill { flex-shrink: 0; height: var(--size-element-lg); padding: 0 var(--spacing-3); border: none; border-bottom: 2px solid transparent; margin-bottom: -1px; border-radius: 0; background: transparent; color: var(--color-text-secondary); font-size: 13px; font-weight: 600; cursor: pointer; transition: color 0.15s, border-color 0.15s; white-space: nowrap; }
  .cat-pill.active { background: transparent; color: var(--color-accent); border-bottom-color: var(--color-accent); box-shadow: none; }
  .cat-pill:hover { color: var(--color-text-primary); }
  .cat-pill.active { background: transparent; color: var(--color-accent); border-bottom-color: var(--color-accent); box-shadow: none; }
  /* 展开来源 */
  .src-expand { display: inline; font-size: 11px; }
  .src-expand summary { cursor: pointer; color: var(--accent); list-style: none; }
  .src-expand summary::-webkit-details-marker { display: none; }
  .src-list { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
  .src-item { padding: var(--spacing-0-5) var(--spacing-2); border-radius: var(--radius-xs); background: var(--accent-soft); color: var(--color-accent); font-size: 10px; }
  .hidden { display: none !important; }
  @media (max-width: 640px) {
    .page-wrap { padding: 0 14px 40px; }
    .stats-bar { padding: 10px 12px; }
    .stats-bar-item { padding: 0 12px; }
    .stats-bar-value { font-size: 1.1em; }
    .entry-title { font-size: 15px; }
    .entry-summary { font-size: 12px; -webkit-line-clamp: 2; }
    .back-to-top { bottom: 20px; right: 20px; width: 40px; height: 40px; }
  }
</style>

<div class="page-wrap">
  <div class="page-head">
      <Header mode="home" date={v4Date} totalItems={totalItems} today={today} />
      <h1 style={{fontSize:'1.05em',fontWeight:700,color:'var(--ink)',margin:'16px 0',letterSpacing:'-.3px'}}>{displayDate} · 情报日报</h1>
      <div class="stats-bar">
        <div class="stats-bar-item"><span class="stats-bar-value">{totalItems}</span><span class="stats-bar-label">今日情报</span></div>
        <div class="stats-bar-divider"></div>
        <div class="stats-bar-item"><span class="stats-bar-value">{v4Data?.total_sources || recentDates.length}</span><span class="stats-bar-label">采集源</span></div>
        <div class="stats-bar-divider"></div>
        <div class="stats-bar-item highlight"><span class="stats-bar-value">{highScoreCount}</span><span class="stats-bar-label">高价值信号</span></div>
      </div>
  </div>
  <div class="shell">
    <SiteNav active="home" today={today} />
    <div class="shell-main">
      {/* 首页搜索：只搜今日已渲染的 30 条，不搜全库；与分类筛选叠加生效 */}
      <div class="search-row">
        <input type="search" id="homeSearch" placeholder="搜索今日 30 条（标题 / 摘要 / 来源）" aria-label="搜索今日情报" autocomplete="off" />
        <span class="search-count" id="searchCount"></span>
        <a class="search-all-link" href="/search/">搜全站 →</a>
      </div>
      <div class="search-empty" id="searchEmpty">没有匹配的条目，换个词试试。</div>
      {/* 分类筛选 */}
      {v4Data?.by_category && (
        <div class="cat-filter" id="catFilter">
          <button class="cat-pill active" data-cat="all">全部情报</button>
          {Object.keys(v4Data.by_category).map((cat) => (
            <button class="cat-pill" data-cat={cat}>{cat}</button>
          ))}
        </div>
      )}

      <script>
        const catFilter = document.getElementById('catFilter');
        if (catFilter) {
          catFilter.addEventListener('click', (e: Event) => {
            const btn = (e.target as HTMLElement).closest('.cat-pill') as HTMLElement | null;
            if (!btn) return;
            const cat = btn.dataset.cat || 'all';
            catFilter.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.querySelectorAll('.entry-item').forEach(el => {
              if (cat === 'all') {
                el.classList.remove('hidden');
              } else {
                el.classList.toggle('hidden', (el as HTMLElement).dataset.category !== cat);
              }
            });
          });
        }
      </script>

      {(() => {
        const featuredItems: any[] = [];
        if (v4Data?.by_category) {
          for (const cat of Object.values(v4Data.by_category)) {
            for (const it of (cat as any[])) {
              if (it.ai_summary && String(it.ai_summary).trim()) {
                featuredItems.push(it);
              }
            }
          }
        }
        // v4：精选按展示分（ai_score 优先）排，取 8 条，宁缺毋滥；
        // 原来按 score 排，前 21 条全是 10.0，并列顺序等于分类遍历顺序，是假的排序。
        featuredItems.sort((a, b) => (displayScore(b) - displayScore(a)) || ((b.score || 0) - (a.score || 0)));
        const topFeatured = featuredItems.slice(0, 8);
        
        if (topFeatured.length === 0) return null;
        
        return (
          <>
            <h2 class="featured-title">今日精选 <span class="featured-count">{topFeatured.length}</span></h2>
            <div class="featured-grid">
              {topFeatured.map((item: any, i: number) => {
                const s = displayScore(item);
                const barW = Math.min(Math.max(s / 10, 0), 1) * 100;
                return (
                <article class="featured-card" key={i}>
                  <div class="featured-top">
                    <span class="featured-rank">{i + 1}</span>
                    <span class="featured-score" title="AI 评分（ai_score 字段原值，量纲待管线确认）">
                      <span class="featured-score-num">{s.toFixed(1)}</span>
                      <span class="featured-score-bar"><span style={{width: `${barW}%`}}></span></span>
                    </span>
                  </div>
                  <h3><a href={item.url} target="_blank" rel="noopener">{item.ai_title || item.title}</a></h3>
                  <p class="featured-summary">{item.ai_summary}</p>
                  {item.ai_reason && (<p class="featured-reason" title="点击展开 / 收起">{item.ai_reason}</p>)}
                  <div class="featured-meta">
                    <span>{item.source}</span>
                    {fmtHM((item as any).published_at) && <span class="featured-time">{fmtHM((item as any).published_at)}</span>}
                    {(item.source_count || 0) > 1 && <span>📰 {item.source_count}家报道</span>}
                  </div>
                </article>
                );
              })}
            </div>
          </>
        );
      })()}

      <h2 class="stream-title">今日情报流</h2>
      <div class="timeline-wrap">
        {sortedDates.map(dateStr => {
          const dayItems = groupedByDate.get(dateStr) || [];
          const sorted = [...dayItems].sort((a, b) => (b.score || 0) - (a.score || 0));
          if (dateStr !== today) return null;
          const dy = dateStr.slice(0,4), dm = dateStr.slice(5,7), dd = dateStr.slice(8,10);
          const dayLabel = dateStr === today ? '今天' : `${dm}月${dd}日`;
          return (
            <section>
              <div class="day-header">
                <span class="day-label">{dayLabel}</span>
                <span class="day-date">{dy}-{dm}-{dd}</span>
                <span class="day-count">{sorted.length} 条</span>
              </div>
              {sorted.slice(0, 30).map(item => {
                const ds = displayScore(item);
                const g = gradeBadge(ds), gLabel = gradeLabel(ds);
                const timeStr = fmtHM((item as any).published_at);
                const platform = item.platform_label || item.source || '';
                const summary = item.ai_summary || item.desc || item.title;
                const displayTitle = item.ai_title || item.title;
                const reason = item.ai_reason || '';
                return (
                  <article class="entry entry-item" id={`entry-${item.id}`} data-category={item.category || '其他'}>
                    <div class="entry-meta">
                      {timeStr && <span class="entry-time">{timeStr}</span>}
                      {timeStr && platform && <span class="entry-sep">·</span>}
                      {platform && <span class="entry-source">{platform}</span>}
                      {(item as any).source_count > 1 ? (
                        <details class="src-expand">
                          <summary>📰 {(item as any).source_count}家报道</summary>
                          <div class="src-list">
                            {(item as any).sources?.map((s: string, si: number) => (
                              <span class="src-item" key={si}>{s}</span>
                            ))}
                          </div>
                        </details>
                      ) : (item as any).source_count > 0 && (
                        <span class="src-count">📰 {(item as any).source_count}家报道</span>
                      )}
                      <span class={`grade-pill grade-${g}`}>{gLabel}</span>
                      
                      {ds > 0 && <span class="ai-score-badge">AI 评分 {ds.toFixed(1)}</span>}
                    </div>
                    <a href={item.url || '#'} target="_blank" rel="noopener" class="entry-title">{displayTitle}</a>
                    {summary && summary.length > 10 && <p class="entry-summary">{summary.slice(0, 150)}{summary.length > 150 ? '…' : ''}</p>}
                    {reason && (<div class="entry-reason"><span class="entry-reason-label">推荐理由：</span>{reason}</div>)}
                  </article>
                );
              })}
              {sorted.length > 30 && (<a class="more-link" href={`/day/${dateStr}/`}>查看今日全部 {sorted.length} 条 →</a>)}
            </section>
          );
        })}
      </div>
    </div>
    
    <aside class="shell-right">
      <button class="rail-toggle" id="railCollapse" aria-label="收起右侧栏">收起右侧栏 →</button>
      {allDates.length > 0 && <section><CalendarWidget dates={allDates} basePath="/day/" locale="zh" /></section>}
      {hotTerms.length > 0 && (
        <section class="rail-card">
          <div class="rail-title">🔎 今日新词 <a href="/new-terms/" class="rail-more">全部 →</a></div>
          <ul class="rail-terms">
            {hotTerms.map((t: any) => (
              <li><span class="rail-term">{t.term}</span><span class="rail-count">{t.today_count || 0} 篇</span></li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  
</div>
  <Footer />
</div>
<button class="rail-expand" id="railExpand" aria-label="展开右侧栏">← 展开</button>
<button id="backToTop" class="back-to-top" aria-label="回到顶部">↑</button>
<script>
  const backBtn = document.getElementById('backToTop');
  if (backBtn) {
    window.addEventListener('scroll', () => { backBtn.classList.toggle('visible', window.scrollY > 300); });
    backBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }
  // 首页搜索 + 分类叠加过滤：只动今日已渲染的 30 条
  const searchInput = document.getElementById('homeSearch') as HTMLInputElement | null;
  const searchCount = document.getElementById('searchCount');
  const searchEmpty = document.getElementById('searchEmpty');
  const entryItems = Array.from(document.querySelectorAll('.entry-item')) as HTMLElement[];
  let activeCat = 'all';
  function applyHomeFilters() {
    const q = (searchInput?.value || '').trim().toLowerCase();
    let shown = 0;
    entryItems.forEach(el => {
      const catOk = activeCat === 'all' || el.dataset.category === activeCat;
      const qOk = !q || (el.textContent || '').toLowerCase().includes(q);
      const vis = catOk && qOk;
      el.classList.toggle('hidden', !vis);
      if (vis) shown++;
    });
    if (searchCount) searchCount.textContent = q ? `${shown} / ${entryItems.length}` : '';
    if (searchEmpty) searchEmpty.style.display = (q && shown === 0) ? 'block' : 'none';
  }
  searchInput?.addEventListener('input', applyHomeFilters);
  document.querySelectorAll('#catFilter .cat-pill').forEach(btn => {
    btn.addEventListener('click', () => { activeCat = (btn as HTMLElement).dataset.cat || 'all'; applyHomeFilters(); });
  });
  // 分类标签行右侧渐隐：滑到头就取消渐隐；一行放得下时也不渐隐
  const catFilter = document.getElementById('catFilter');
  function syncCatFade() {
    if (!catFilter) return;
    catFilter.classList.toggle('at-end', catFilter.scrollLeft + catFilter.clientWidth >= catFilter.scrollWidth - 2);
  }
  catFilter?.addEventListener('scroll', syncCatFade, { passive: true });
  window.addEventListener('resize', syncCatFade);
  syncCatFade();
  // 精选推荐理由：默认一行，点击展开 / 收起
  document.querySelectorAll('.featured-reason').forEach(el => {
    el.addEventListener('click', () => el.classList.toggle('expanded'));
  });
  // 右栏收起：宽屏才有右栏，选了就记住
  const railKey = 'daily-rail-collapsed';
  if (localStorage.getItem(railKey) === '1') document.body.classList.add('rail-collapsed');
  document.getElementById('railCollapse')?.addEventListener('click', () => {
    document.body.classList.add('rail-collapsed');
    localStorage.setItem(railKey, '1');
  });
  document.getElementById('railExpand')?.addEventListener('click', () => {
    document.body.classList.remove('rail-collapsed');
    localStorage.setItem(railKey, '0');
  });
</script>
</BaseLayout>


