---
// 全站搜索页 — 搜全部历史日报（标题 + 摘要片段），不再只搜当日 30 条
// 索引按月分片、构建时生成（/search-index.json 清单 + /search-index/YYYY-MM.json 分片），
// 打开先加载最新月份，点“加载全部月份”再补更早的；结果链到日报页对应条目锚点。
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteNav from '../components/SiteNav.astro';
import { getAllDates } from '../utils/data.ts';

const dates = getAllDates('zh');
---

<BaseLayout title="🔍 全站搜索 · 豆子实验室" description="搜索豆子实验室全部历史情报：标题与摘要，全站可查。">
<style>
  .search-page h1 { font-size: 1.3em; font-weight: 800; color: var(--text-h); }
  .search-page .sub { font-size: 0.82em; color: var(--text-m); margin-top: 6px; }
  .search-box { display: flex; gap: 8px; margin: 20px 0 8px; }
  .search-box input { flex: 1; padding: 10px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--bg-card); color: var(--ink); font-size: 15px; font-family: inherit; }
  .search-box input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .search-status { font-size: 12px; color: var(--ink-4); font-family: var(--font-mono); margin-bottom: 16px; }
  .search-status button { margin-left: 8px; padding: 2px 10px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: transparent; color: var(--accent); cursor: pointer; font-size: 12px; }
  .search-results { display: flex; flex-direction: column; }
  .search-result { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .search-result:last-child { border-bottom: none; }
  .search-result a.result-title { font-size: 15px; font-weight: 600; color: var(--ink); text-decoration: none; }
  .search-result a.result-title:hover { color: var(--accent); }
  .result-meta { font-size: 11px; color: var(--ink-4); margin-top: 4px; font-family: var(--font-mono); }
  .result-snippet { font-size: 13px; color: var(--ink-3); margin-top: 4px; line-height: 1.6; }
  .search-hint { font-size: 13px; color: var(--ink-4); padding: 24px 0; }
  .search-empty { font-size: 13px; color: var(--ink-4); padding: 24px 0; }
</style>

<div class="page">
  <Header mode="archive" />
  <div class="shell shell--flush">
    <SiteNav active="none" today={dates[0]} />
    <div class="shell-main search-page">
      <h1>🔍 全站搜索</h1>
      <p class="sub">搜全部历史日报的标题与摘要，不只搜今天。结果按日期倒序，点标题跳到当天日报的对应条目。</p>
      <div class="search-box">
        <input type="search" id="siteSearch" placeholder="输入关键词，如 黄仁勋、DeepSeek、机器人…" aria-label="全站搜索" autocomplete="off" />
      </div>
      <div class="search-status" id="searchStatus">正在加载索引…</div>
      <div class="search-results" id="searchResults"></div>
      <div class="search-hint" id="searchHint">输入关键词开始搜索。索引先加载最新月份，可点状态栏里的“加载全部月份”补全历史。</div>
      <div class="search-empty" id="searchEmpty" hidden>没有匹配的条目，换个词试试，或者点“加载全部月份”再搜。</div>
    </div>
  </div>
  <Footer />
</div>

<script>
  const input = document.getElementById('siteSearch') as HTMLInputElement | null;
  const statusEl = document.getElementById('searchStatus');
  const resultsEl = document.getElementById('searchResults') as HTMLElement | null;
  const hintEl = document.getElementById('searchHint');
  const emptyEl = document.getElementById('searchEmpty');

  type IdxItem = { t: string; d: string; i: number; s: number; a: string; p: string };
  let allItems: IdxItem[] = [];
  let loadedMonths: string[] = [];
  let allMonths: { month: string; count: number }[] = [];
  let total = 0;

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function renderStatus() {
    if (!statusEl) return;
    const loaded = allItems.length;
    const more = allMonths.filter(m => !loadedMonths.includes(m.month));
    statusEl.innerHTML = `已加载 ${loadedMonths.length ? loadedMonths.join('、') : '—'}（${loaded.toLocaleString()} 条），全站共 ${total.toLocaleString()} 条。` +
      (more.length ? ` <button id="loadAllMonths" type="button">加载全部月份（还剩 ${more.length} 个月）</button>` : ' 已全部加载。');
    const btn = document.getElementById('loadAllMonths');
    btn?.addEventListener('click', loadAllMonths);
  }

  async function loadShard(month: string) {
    try {
      const r = await fetch(`/search-index/${month}.json`);
      if (!r.ok) return;
      const j = await r.json();
      allItems = allItems.concat(j.items || []);
      loadedMonths.push(month);
    } catch {}
  }

  async function loadAllMonths() {
    const rest = allMonths.filter(m => !loadedMonths.includes(m.month));
    for (const m of rest) await loadShard(m.month);
    renderStatus();
    runSearch();
  }

  function runSearch() {
    const q = (input?.value || '').trim().toLowerCase();
    if (!resultsEl) return;
    if (!q) {
      resultsEl.innerHTML = '';
      if (hintEl) hintEl.hidden = false;
      if (emptyEl) emptyEl.hidden = true;
      return;
    }
    if (hintEl) hintEl.hidden = true;
    const tokens = q.split(/\s+/).filter(Boolean);
    const hits = allItems.filter(it => {
      const hay = (it.t + ' ' + (it.a || '')).toLowerCase();
      return tokens.every(tk => hay.includes(tk));
    });
    hits.sort((a, b) => (b.d.localeCompare(a.d)) || ((b.s || 0) - (a.s || 0)));
    const top = hits.slice(0, 50);
    if (emptyEl) emptyEl.hidden = top.length > 0;
    resultsEl.innerHTML = top.map(it => {
      const score = it.s > 0 ? ` · AI 评分 ${Number(it.s).toFixed(1)}` : '';
      const src = it.p ? ` · ${esc(it.p)}` : '';
      const snip = it.a ? `<div class="result-snippet">${esc(it.a)}</div>` : '';
      return `<article class="search-result"><a class="result-title" href="/day/${it.d}/#entry-${it.i}">${esc(it.t)}</a><div class="result-meta">${it.d}${src}${score} <button class="fav-btn" type="button" data-fav-id="${it.d}:${it.i}" data-fav-title="${esc(it.t)}" data-fav-date="${it.d}" data-fav-url="/day/${it.d}/#entry-${it.i}" data-fav-score="${it.s}" aria-label="收藏">☆</button></div>${snip}</article>`;
    }).join('') + (hits.length > 50 ? `<div class="search-hint">共 ${hits.length} 条，只显示前 50 条，换更具体的词缩小范围。</div>` : '');
    (window as any).__dailyFavRefresh?.();
  }

  let timer: number | undefined;
  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(runSearch, 150);
  });

  // 支持 ?q= 直达（可分享的搜索链接）
  const startQ = new URLSearchParams(location.search).get('q') || '';
  (async () => {
    try {
      const r = await fetch('/search-index.json');
      const j = await r.json();
      allMonths = j.months || [];
      total = j.total || 0;
    } catch {}
    if (allMonths.length > 0) await loadShard(allMonths[0].month);
    renderStatus();
    if (startQ && input) {
      input.value = startQ;
      runSearch();
    }
  })();
</script>
</BaseLayout>
