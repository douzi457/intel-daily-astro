---
// Intel Officer Dashboard — AI 情报官驾驶舱
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import LayoutShell from '../../components/LayoutShell.astro';
import type { V2DailyData } from '../../lib/types-v2.ts';

let v2Data: V2DailyData | null = null;
try {
  const v2Index = await import('../../../public/data/v2/index.json').catch(() => null);
  if (v2Index?.default?.latest_date) {
    const mod = await import(`../../../public/data/v2/daily-${v2Index.default.latest_date}-v2.json`).catch(() => null);
    v2Data = mod?.default as V2DailyData | null;
  }
} catch {}

// 统一使用 v4 的日期（v4 总是最新）
let v4Date: string | null = null;
try {
  const v4Index = await import('../../data/v4/index.json').catch(() => null);
  v4Date = v4Index?.default?.latest_date || null;
} catch {}

const date = v4Date || v2Data?.date || new Date().toISOString().slice(0, 10);
const today = new Date().toISOString().slice(0, 10);
const qualityGrade = v2Data?.quality?.grade || 'pilot';
const qualityColor = qualityGrade === 'pass' ? '#10b981' : qualityGrade === 'pilot' ? '#f59e0b' : '#ef4444';

// 分类数据（供JS使用）
const CATEGORIES = ['AI模型', '开源项目', '大厂动态', '创业融资', '工具应用', '其他'];
const categories = v2Data?.categories || {};
// 全部信号（JS做客户端过滤，不预处理）
const allSignals = v2Data?.core_signals || [];

// 生成前一日/后一日日期（用于导航）
const cur = new Date(date + 'T00:00:00+08:00');
const prevDate = new Date(cur.getTime() - 86400000).toISOString().slice(0, 10);
const nextDate = new Date(cur.getTime() + 86400000).toISOString().slice(0, 10);

// 获取近7天日期列表（用于归档入口）
const datesList: string[] = [];
for (let i = 0; i < 7; i++) {
  datesList.push(new Date(cur.getTime() - i * 86400000).toISOString().slice(0, 10));
}

// 数据来源统计
const sourceStats = (v2Data?.source_health || [])
  .sort((a, b) => b.count - a.count)
  .slice(0, 5)
  .map(s => `${s.name}(${s.count})`)
  .join('、') || '暂无';

const categoryCounts = new Map<string, number>();
(v2Data?.events || []).forEach(e => {
  (e.tags || []).forEach(t => categoryCounts.set(t, (categoryCounts.get(t) || 0) + 1));
});
const topCategories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5)
  .map(([k, v]) => `${k}:${v}`)
  .join('、') || '暂无';

// 格式化时间
function fmtTime(iso?: string) {
  if (!iso) return '未知';
  try {
    return new Date(iso).toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
  } catch { return '未知'; }
}

// 判断是否有真实引文（过滤占位语）
function hasRealQuotes(quotes: any[]): boolean {
  if (!quotes || !Array.isArray(quotes) || quotes.length === 0) return false;
  return quotes.some((q: any) => {
    const t = (q && q.text ? String(q.text) : '').trim();
    return t !== '' && t !== '暂无可引用的公开原话' && !t.startsWith('暂无');
  });
}

// 判断是否重复于今日结论
function isDupOfSummary(text: string, summaries: string[]): boolean {
  if (!text) return false;
  const t = text.trim().toLowerCase();
  if (!t) return false;
  return (summaries || []).some(s => {
    const st = (s || '').trim().toLowerCase();
    return st && (st.includes(t) || t.includes(st));
  });
}

const DEEP_LABELS: Record<string, string> = {
  background: '背景', divergence: '分歧', comparison: '对照',
  principle: '原理', impact: '影响', solution: '解法',
  highlight: '看点', treasure: '宝藏', method: '挖法',
  current_state: '现状', variable: '变量', projection: '推演',
};

function cardTypeColor(t: string): string {
  return t === '观点型' ? '#c0392b' : t === '教程型' ? '#2980b9' : t === '资讯型' ? '#27ae60' : '#8e44ad';
}

// 判断是否有真实引文（过滤占位语）
function hasRealQuotes(quotes: any): boolean {
  if (!quotes || !Array.isArray(quotes) || quotes.length === 0) return false;
  return quotes.some((q: any) => {
    const t = (q && q.text ? String(q.text) : '').trim();
    return t !== '' && t !== '暂无可引用的公开原话' && !t.startsWith('暂无');
  });
}

// 归一化英文标点（修复弯引号渲染问题）
function normalize(text: string): string {
  if (!text) return '';
  return text
    .replace(/'/g, "'")
    .replace(/'/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}
---

<BaseLayout title="AI 情报官 | 豆子实验室">
  <style>
    :root {
      --bg: #faf9f6; --ink: #202a30; --ink-2: #303c42; --ink-3: #59656b; --ink-4: #657176;
      --accent: #c73e3a; --surface: #fff; --border: #d4d0c8; --muted: #8a8578;
      --paper: #f5f3ee; --line: #e0dcd4;
      --color-bg: #faf9f6; --color-surface: #fff; --color-border: #d4d0c8;
      --color-text: #202a30; --color-text-muted: #59656b; --color-accent: #c73e3a;
      --color-core: #10b981; --color-watch: #f59e0b; --color-action: #8b5cf6;
    }
    [data-theme="dark"] {
      --bg: #13191c; --ink: #e7eceb; --ink-2: #c8d0cf; --ink-3: #8a9a9a; --ink-4: #6a7a7a;
      --accent: #e85d59; --surface: #1a2227; --border: #2a3539; --muted: #5a6a6a;
      --paper: #171e22; --line: #252e33;
      --color-bg: #13191c; --color-surface: #1a2227; --color-border: #2a3539;
      --color-text: #e7eceb; --color-text-muted: #8a9a9a; --color-accent: #e85d59;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', 'Segoe UI', Roboto, sans-serif; line-height: 1.6; }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }

    /* ── Topbar ── */
    .topbar { background: var(--surface); border-bottom: 2px solid var(--accent); padding: 12px 0; position: sticky; top: 0; z-index: 100; }
    .topbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .brand { font-size: 17px; font-weight: 700; letter-spacing: -0.01em; }
    .brand span { color: var(--accent); }
    .meta-info { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--ink-3); flex-wrap: wrap; }
    .q-badge { display: inline-flex; align-items: center; gap: 5px; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 700; background: var(--paper); border: 1px solid var(--border); }
    .q-dot { width: 7px; height: 7px; border-radius: 50%; }
    .copy-btn { display: inline-flex; align-items: center; gap: 5px; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; border: 1px solid var(--border); background: var(--paper); color: var(--ink-2); cursor: pointer; transition: all .15s; margin-left: auto; }
    .copy-btn:hover { border-color: var(--accent); color: var(--accent); }
    .copy-btn.copied { border-color: var(--accent); color: var(--accent); background: rgba(23,107,117,.08); }
    .theme-btn { background: none; border: 1px solid var(--border); border-radius: 6px; padding: 4px 8px; cursor: pointer; font-size: 14px; color: var(--ink-3); line-height: 1; }
    .theme-btn:hover { border-color: var(--accent); color: var(--accent); }

    /* ── 日期导航 ── */
    .date-nav { display: flex; align-items: center; gap: 6px; margin-bottom: 20px; flex-wrap: wrap; }
    .date-nav-btn { display: inline-flex; align-items: center; gap: 4px; padding: 4px 12px; border-radius: 5px; font-size: 12px; font-weight: 500; border: 1px solid var(--border); background: var(--surface); color: var(--ink-3); text-decoration: none; cursor: pointer; transition: all 0.15s; }
    .date-nav-btn:hover { border-color: var(--accent); color: var(--accent); }
    .date-nav-btn.current { background: var(--accent); color: white; border-color: var(--accent); }
    .date-nav-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .date-nav-btn:disabled:hover { border-color: var(--border); color: var(--ink-4); }
    .date-nav-sep { color: var(--muted); font-size: 11px; }
    .archive-dropdown { position: relative; }
    .archive-menu { display: none; position: absolute; top: 100%; left: 0; margin-top: 4px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 4px; min-width: 140px; z-index: 200; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
    .archive-dropdown:hover .archive-menu, .archive-menu:hover { display: block; }
    .archive-menu a { display: block; padding: 5px 10px; font-size: 12px; color: var(--ink-3); text-decoration: none; border-radius: 4px; }
    .archive-menu a:hover { background: var(--paper); color: var(--accent); }

    main { max-width: 1100px; margin: 0 auto; padding: 24px 20px 60px; }
    .executive-summary { background: var(--paper); border-left: 3px solid var(--accent); border-radius: 0 8px 8px 0; padding: 14px 18px; margin-bottom: 24px; }
    .section-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-4); margin-bottom: 10px; }
    .summary-list { list-style: none; counter-reset: exec; display: flex; flex-direction: column; gap: 7px; }
    .summary-item { counter-increment: exec; display: flex; gap: 10px; font-size: 14px; line-height: 1.6; }
    .summary-item::before { content: counter(exec); background: var(--accent); color: #fff; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; flex-shrink: 0; margin-top: 1px; }
    .summary-text { font-size: 14px; line-height: 1.6; }

    /* ── 复制按钮 ── */
    .copy-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text); cursor: pointer; transition: all 0.15s; margin-left: auto; }
    .copy-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
    .copy-btn.copied { border-color: var(--color-core); color: var(--color-core); }

    /* ── Dashboard Grid ── */
    .dashboard-grid { display: grid; grid-template-columns: 1fr 300px; gap: 16px; margin-bottom: 24px; }
    @media (max-width: 860px) { .dashboard-grid { grid-template-columns: 1fr; } }

    /* ── Core Signal Cards (Timeline) ── */
    .core-signals { display: flex; flex-direction: column; gap: 16px; }
    .timeline { position: relative; padding-left: 28px; }
    .timeline::before { content: ''; position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; background: var(--line); }
    .tl-item { position: relative; margin-bottom: 16px; }
    .tl-item::before { content: ''; position: absolute; left: -24px; top: 8px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); }
    .tl-time { font-size: 11px; color: var(--ink-4); margin-bottom: 4px; font-variant-numeric: tabular-nums; }
    .signal-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; transition: border-color 0.15s; }
    .signal-card:hover { border-color: var(--accent); }
    .signal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
    .signal-rank { background: var(--accent); color: white; width: 22px; height: 22px; border-radius: 5px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; flex-shrink: 0; margin-top: 2px; }
    .signal-title-wrap { flex: 1; min-width: 0; }
    .signal-title { font-size: 15px; font-weight: 600; line-height: 1.45; color: var(--ink); text-decoration: none; display: block; word-break: break-word; }
    .signal-title:hover { color: var(--accent); }
    .signal-grade { display: inline-flex; align-items: center; gap: 3px; padding: 1px 7px; border-radius: 10px; font-size: 10px; font-weight: 700; margin-left: 6px; vertical-align: middle; }
    .grade-high { background: rgba(16,185,129,.12); color: #059669; }
    .grade-mid { background: rgba(245,158,11,.12); color: #d97706; }
    .grade-low { background: rgba(239,68,68,.12); color: #dc2626; }
    .signal-meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: 11px; color: var(--ink-4); margin-bottom: 8px; }
    .signal-meta a { color: var(--accent); text-decoration: none; }
    .signal-meta a:hover { text-decoration: underline; }
    .report-count { background: var(--paper); border: 1px solid var(--border); padding: 1px 6px; border-radius: 4px; font-size: 10px; }
    .signal-summary { font-size: 13px; color: var(--ink-3); margin-bottom: 8px; line-height: 1.55; }
    .signal-section { margin-bottom: 8px; }
    .signal-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-4); margin-bottom: 3px; }
    .signal-value { font-size: 13px; line-height: 1.55; }
    .signal-value.important { color: var(--accent); }
    .signal-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; }
    .tag { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 10px; border: 1px solid var(--border); color: var(--ink-4); background: var(--paper); margin-right: 4px; }
    .tag.highlight { background: rgba(23,107,117,.08); border-color: var(--accent); color: var(--accent); }
    .card-type-badge { display: inline-block; padding: 1px 8px; border-radius: 4px; font-size: 10px; font-weight: 700; margin-bottom: 8px; }
    .why-box { background: var(--paper); border-left: 3px solid var(--accent); padding: 8px 12px; margin-bottom: 8px; font-size: 13px; color: var(--ink-2); line-height: 1.55; }

    /* ── Sidebar ── */
    .sidebar { display: flex; flex-direction: column; gap: 20px; }
    .actions-section, .data-source-section { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; padding: 18px; }
    .action-card { background: rgba(139,92,246,0.1); border: 1px solid rgba(139,92,246,0.3); border-radius: 8px; padding: 14px; margin-bottom: 10px; }
    .action-type { display: inline-block; background: var(--color-action); color: white; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 700; text-transform: uppercase; margin-bottom: 6px; }
    .action-title { font-size: 13px; font-weight: 600; margin-bottom: 6px; }
    .action-meta { font-size: 11px; color: var(--color-text-muted); }

    /* 数据来源样式 */
    .data-source-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 12px; }
    .data-source-item { display: flex; flex-direction: column; gap: 2px; }
    .data-source-item span:first-child { color: var(--color-text-muted); }
    .data-source-item span:last-child { font-weight: 600; }
    .data-source-full { grid-column: 1 / -1; }
    .data-source-full span:first-child { color: var(--color-text-muted); margin-bottom: 2px; display: block; }
    .data-source-full span:last-child { font-weight: 500; font-size: 12px; line-height: 1.5; }

    /* ── Fold blocks ── */
    details.analysis-block { margin: 6px 0; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
    details.analysis-block summary { padding: 8px 12px; font-size: 12px; font-weight: 600; color: var(--ink-3); cursor: pointer; background: var(--paper); list-style: none; display: flex; align-items: center; gap: 6px; }
    details.analysis-block summary::before { content: '\25B8'; font-size: 10px; transition: transform .15s; }
    details.analysis-block[open] summary::before { transform: rotate(90deg); }
    details.analysis-block summary:hover { color: var(--accent); }
    .analysis-content { padding: 10px 12px; font-size: 13px; line-height: 1.6; color: var(--ink-2); }
    .analysis-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
    .analysis-item-label { font-size: 11px; font-weight: 700; color: var(--ink-4); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 3px; }
    .analysis-item-text { font-size: 13px; line-height: 1.55; color: var(--ink-2); }

    details.quotes-block { margin: 6px 0; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
    details.quotes-block summary { padding: 8px 12px; font-size: 12px; font-weight: 600; color: var(--ink-3); cursor: pointer; background: var(--paper); list-style: none; }
    details.quotes-block summary::before { content: '\25B8'; font-size: 10px; }
    details.quotes-block[open] summary::before { transform: rotate(90deg); }
    .quotes-list { padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
    .quote-item { border-left: 2px solid var(--accent); padding-left: 10px; }
    .quote-text { font-size: 13px; font-style: italic; color: var(--ink-2); margin-bottom: 2px; }
    .quote-source { font-size: 11px; color: var(--ink-4); }

    .action-script-list { padding-left: 18px; font-size: 13px; color: var(--ink-2); line-height: 1.6; }
    .action-script-list li { margin-bottom: 4px; }

    /* ── Watchlist ── */
    .watchlist-section { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; margin-bottom: 24px; }
    .watchlist-list { list-style: none; display: flex; flex-direction: column; gap: 5px; }
    .watchlist-item { display: flex; align-items: center; gap: 8px; padding: 8px 10px; background: var(--paper); border-radius: 6px; }
    .watchlist-rank { font-size: 10px; color: var(--ink-4); width: 18px; text-align: center; }
    .watchlist-title { font-size: 13px; flex: 1; line-height: 1.4; }
    .watchlist-title a { color: var(--ink); text-decoration: none; }
    .watchlist-title a:hover { color: var(--accent); }
    .watch-dots { display: flex; gap: 3px; }
    .dot { width: 8px; height: 8px; border-radius: 50%; }
    .dot-h { background: #059669; }
    .dot-m { background: #d97706; }
    .dot-l { background: #dc2626; }

    /* ── Empty State ── */
    .empty-state { text-align: center; padding: 48px 24px; color: var(--ink-4); }
    .empty-state h2 { font-size: 18px; margin-bottom: 8px; color: var(--ink-2); }
    .funnel { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--ink-3); margin-bottom: 20px; flex-wrap: wrap; }
    .funnel-number { font-weight: 700; color: var(--ink); }

    /* ── Category Tabs ── */
    .category-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .cat-tab {
      padding: 6px 14px;
      border: 1px solid var(--border);
      border-radius: 20px;
      background: var(--surface);
      color: var(--ink-3);
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .cat-tab:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .cat-tab.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .cat-count {
      margin-left: 4px;
      font-size: 11px;
      opacity: 0.7;
    }

    /* ── Mobile ── */
    @media (max-width: 640px) {
      .container { padding: 0 14px; }
      .topbar-inner { gap: 10px; }
      .brand { font-size: 15px; }
      .meta-info { font-size: 12px; gap: 8px; }
      main { padding: 16px 14px 40px; }
      .executive-summary { padding: 16px; }
      .summary-text { font-size: 14px; }
      .dashboard-grid { gap: 16px; }
      .signal-card { padding: 12px; }
      .signal-title { font-size: 14px; }
      .data-source-grid { grid-template-columns: 1fr; }
      .copy-btn { width: 100%; justify-content: center; }
      .analysis-grid { grid-template-columns: 1fr; }
    }
  </style>

  <Header mode="officer" date={date} totalItems={v2Data?.stats?.raw_items || 0} today={today} />
  <div class="topbar">
    <div class="container topbar-inner" style={{'--quality-color': qualityColor}}>
      <div class="brand">豆子实验室 · <span>AI 情报官</span></div>
      <div class="meta-info">
        <span>{date}</span>
        <span class="q-badge" style={{ '--color-quality': qualityColor }}>
          <span class="q-dot" style={{ 'background': qualityColor }}></span>
          {v2Data?.quality?.total || 0}/100 {qualityGrade.toUpperCase()}
        </span>
        <button class="copy-btn" id="copyBtn" data-date={date} title="复制日报 Markdown">📋 复制日报</button>
        <button class="theme-btn" id="themeBtn" title="切换主题">🌓</button>
      </div>
    </div>
  </div>

  <div class="shell">
    <div slot="left">
      <main>
        <div class="container">
          {!v2Data ? (
            <div class="empty-state">
              <h2>暂无情报数据</h2>
              <p>请稍后再试，或检查数据采集状态</p>
            </div>
          ) : (
            <>
              {/* 日期导航 */}
              <div class="date-nav">
                <a href={`/officer/?date=${prevDate}`} class={`date-nav-btn ${date === prevDate ? 'current' : ''}`} title="前一天">
                  ← 前一天
                </a>
                <span class="date-nav-sep">|</span>
                <span class="date-nav-btn current" style={{cursor:'default'}}>{date}</span>
                <span class="date-nav-sep">|</span>
                <a href={`/officer/?date=${nextDate}`} class="date-nav-btn" title="下一天">
                  下一天 →
                </a>
                <div class="archive-dropdown">
                  <button class="date-nav-btn">📅 近7天</button>
                  <div class="archive-menu">
                    {datesList.map(d => (
