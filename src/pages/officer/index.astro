                      <span class="watchlist-title">
                        {event.url ? <a href={event.url} target="_blank" rel="noopener">{normalize(event.headline)}</a> : normalize(event.headline)}
                      </span>
                      <div class="watch-dots">{dots}</div>
                    </li>
                  );
                })}
              </ul>
            </section>
          )}
        </>
      )}
    </div>
  </main>
