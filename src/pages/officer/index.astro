                  else if (score >= 80) dots = [<span class="dot dot-m" key="m"/>,<span class="dot dot-m" key="m2"/>,<span class="dot dot-l" key="l"/>];
                  else dots = [<span class="dot dot-l" key="l"/>,<span class="dot dot-l" key="l2"/>,<span class="dot dot-l" key="l3"/>];
                  return (
