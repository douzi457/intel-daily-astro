---
// 热点榜页面 — AIHOT 暖纸风深度复刻
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CalendarWidget from '../../components/CalendarWidget.astro';
import { getDayData, getAllDates } from '../../utils/data.ts';
import type { IntelItem, V4DailyData } from '../../lib/types';

let v4Data: V4DailyData | null = null;
try {
  const v4Index = await import('../../data/v4/index.json');
  const latestDate = v4Index.default.latest_date;
  if (latestDate) {
    const mod = await import(`../../data/v4/daily-${latestDate}.json`);
    v4Data = mod.default as V4DailyData;
  }
} catch {}

const allDates = getAllDates('zh');
const today = allDates.length > 0 ? allDates[0] : new Date().toISOString().slice(0, 10);
const dayData = getDayData(today, 'zh');
const items: IntelItem[] = dayData.items;
const totalItems = items.length;
const recentDates = allDates.slice(0, 10);

// 排序：source_count 高的在前
const sortedItems = [...items].sort((a, b) => (b.source_count || 0) - (a.source_count || 0));

const highScoreCount = items.filter(i => i.score >= 7).length;
const v4Date = v4Data?.date || today;
const y = v4Date.slice(0,4);
const m = parseInt(v4Date.slice(5,7)).toString();
const d = parseInt(v4Date.slice(8,10)).toString();
const displayDate = `${y}年${m}月${d}日`;

function changeClass(change: number): string {
  if (change > 50) return 'explosive';
  if (change > 0) return 'rising';
  if (change < -20) return 'falling';
  return 'stable';
}
function changeLabel(change: number): string {
  if (change > 50) return '爆';
  if (change > 0) return '↑';
  if (change < -20) return '↓';
  return '—';
}
function sparklinePath(history: Array<{source_count: number}>) {
  if (!history || history.length === 0) return '';
  const max = Math.max(...history.map(h => h.source_count), 1);
  const w = 60, h = 24, pad = 2;
  const step = (w - pad * 2) / Math.max(history.length - 1, 1);
  const points = history.map((h, i) => {
    const x = pad + i * step;
    const y = h - pad - (h.source_count / max) * (h - pad * 2);
    return `${x},${y}`;
  });
  return `M${points.join(' L')}`;
}
---

<BaseLayout title={`${displayDate} 热点榜`} description={`${displayDate} AI/科技情报热度排行`} lang="zh-CN">
<style>
  :root {
    --bg: #faf9f6; --ink: #202a30; --ink-2: #303c42; --ink-3: #59656b; --ink-4: #657176;
    --accent: #176b75; --surface: #fff; --border: #d4d0c8; --paper: #f5f3ee; --line: #e0dcd4;
    --accent-soft: rgba(23,107,117,.08);
  }
  [data-theme="dark"] {
    --bg: #13191c; --ink: #e7eceb; --ink-2: #c8d0cf; --ink-3: #8a9a9a; --ink-4: #6a7a7a;
    --accent: #12ccd8; --surface: #1a2227; --border: #2a3539; --paper: #171e22; --line: #252e33;
    --accent-soft: rgba(18,204,216,.08);
  }
  body { background: var(--bg); color: var(--ink); font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif; line-height: 1.6; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .page-wrap { max-width: 760px; margin: 0 auto; padding: 0 20px 60px; }
  .stats-bar { display: flex; align-items: center; justify-content: center; gap: 0; padding: 14px 20px; margin: 20px 0 28px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; font-size: 13px; }
  .stats-bar-item { text-align: center; padding: 0 24px; }
  .stats-bar-value { display: block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 1.3em; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
  .stats-bar-label { display: block; font-size: 0.85em; color: var(--ink-3); margin-top: 2px; }
  .stats-bar-item.highlight .stats-bar-value { color: var(--accent); }
  .stats-bar-divider { width: 1px; height: 28px; background: var(--border); }

  /* 热点榜卡片 */
  .hot-list { display: flex; flex-direction: column; gap: 16px; }
  .hot-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    transition: box-shadow 0.15s;
  }
  .hot-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.08); }
  .hot-card-top { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 10px; }
  .hot-rank {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 24px; font-weight: 800; color: var(--ink-4);
    min-width: 32px; text-align: center; line-height: 1;
  }
  .hot-rank.top3 { color: var(--accent); }
  .hot-content { flex: 1; min-width: 0; }
  .hot-title {
    font-size: 15px; font-weight: 700; color: var(--ink);
    line-height: 1.4; margin-bottom: 4px;
    display: block; text-decoration: none;
  }
  .hot-title:hover { color: var(--accent); }
  .hot-summary {
    font-size: 12px; color: var(--ink-3); line-height: 1.6;
    margin-bottom: 8px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .hot-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .hot-source { font-size: 11px; color: var(--ink-4); }
  .hot-cat {
    font-size: 10px; padding: 1px 6px; border-radius: 3px;
    background: var(--accent-soft); color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .hot-stats {
    display: flex; align-items: center; gap: 12px;
    margin-left: auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .hot-heat {
    font-size: 18px; font-weight: 800; color: var(--ink);
  }
  .hot-heat-label { font-size: 10px; color: var(--ink-4); }
  .hot-change {
    font-size: 11px; font-weight: 700; padding: 2px 6px;
    border-radius: 4px;
  }
  .hot-change.explosive { background: rgba(239,68,68,.1); color: #dc2626; }
  .hot-change.rising   { background: rgba(245,158,11,.1); color: #d97706; }
  .hot-change.falling  { background: rgba(107,114,128,.1); color: #6b7280; }
  .hot-change.stable   { background: var(--paper); color: var(--ink-4); }
  .hot-sparkline {
    width: 60px; height: 24px;
  }
  .hot-sparkline svg { width: 100%; height: 100%; }
  .hot-sparkline path {
    fill: none; stroke: var(--accent); stroke-width: 1.5;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .hot-sparkline circle {
    fill: var(--accent); stroke: none;
  }

  /* 移动端 */
  @media (max-width: 640px) {
    .page-wrap { padding: 0 14px 40px; }
    .hot-card { padding: 12px; }
    .hot-rank { font-size: 20px; min-width: 28px; }
    .hot-title { font-size: 14px; }
    .hot-stats { gap: 8px; }
    .hot-heat { font-size: 16px; }
  }
</style>

<div class="page-wrap">
  <Header mode="home" date={v4Date} totalItems={totalItems} today={today} />
  <h1 style={{fontSize:'1.05em',fontWeight:700,color:'var(--ink)',margin:'16px 0',letterSpacing:'-.3px'}}>{displayDate} · 热点榜</h1>
  <div class="stats-bar">
    <div class="stats-bar-item"><span class="stats-bar-value">{totalItems}</span><span class="stats-bar-label">今日情报</span></div>
    <div class="stats-bar-divider"></div>
    <div class="stats-bar-item"><span class="stats-bar-value">{v4Data?.total_sources || recentDates.length}</span><span class="stats-bar-label">采集源</span></div>
    <div class="stats-bar-divider"></div>
    <div class="stats-bar-item highlight"><span class="stats-bar-value">{highScoreCount}</span><span class="stats-bar-label">高价值信号</span></div>
  </div>

  <div class="hot-list">
    {sortedItems.slice(0, 10).map((item, idx) => {
      const rank = idx + 1;
      const src = item.source_count || 1;
      const change = item.heat_change_6h || 0;
      const history = item.heat_history || [];
      const path = sparklinePath(history);
      return (
        <div class="hot-card">
          <div class="hot-card-top">
            <div class={`hot-rank ${rank <= 3 ? 'top3' : ''}`}>{rank}</div>
            <div class="hot-content">
              <a href={item.url || '#'} target="_blank" rel="noopener" class="hot-title">{item.title}</a>
              {item.desc && <p class="hot-summary">{item.desc.slice(0, 120)}{item.desc.length > 120 ? '…' : ''}</p>}
              <div class="hot-meta">
                <span class="hot-source">{item.platform_label || item.source || ''}</span>
                {item.category && <span class="hot-cat">{item.category}</span>}
                <div class="hot-stats">
                  <div>
                    <span class="hot-heat">{src}</span>
                    <span class="hot-heat-label">来源</span>
                  </div>
                  <span class={`hot-change ${changeClass(change)}`}>{changeLabel(change)}</span>
                  {path && (
                    <div class="hot-sparkline">
                      <svg viewBox="0 0 60 24" preserveAspectRatio="none">
                        <path d={path} />
                      </svg>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  {allDates.length > 0 && <section style={{marginTop:'32px'}}><CalendarWidget dates={allDates} basePath="/day/" locale="zh" /></section>}
  <Footer />
</div>
</BaseLayout>
