---
// 热点榜页面 — AIHOT 暖纸风深度复刻，读取 V2 数据（含热历史）
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CalendarWidget from '../../components/CalendarWidget.astro';
import LayoutShell from '../../components/LayoutShell.astro';
import { getAllDates } from '../../utils/data.ts';

let v2Data: any = null;
try {
  const v2Index = await import('../../../public/data/v2/index.json').catch(() => null);
  if (v2Index?.default?.latest_date) {
    const mod = await import(`../../../public/data/v2/daily-${v2Index.default.latest_date}-v2.json`).catch(() => null);
    v2Data = mod?.default;
  }
} catch {}

// 统一使用 v4 的日期（v4 总是最新）
let v4Date: string | null = null;
try {
  const v4Index = await import('../../data/v4/index.json').catch(() => null);
  v4Date = v4Index?.default?.latest_date || null;
} catch {}

const allDates = getAllDates('zh');
const today = allDates.length > 0 ? allDates[0] : new Date().toISOString().slice(0, 10);

const v2Items = v2Data?.items || [];
const v2CoreSignals = v2Data?.core_signals || [];
const v2Watchlist = v2Data?.watchlist || [];
// 热点榜用 core_signals + watchlist（最多10条），不用 raw items
const hotItems = [...v2CoreSignals, ...v2Watchlist].slice(0, 10);
const sortedItems = [...hotItems].sort((a: any, b: any) => (b.source_count || 0) - (a.source_count || 0));

const totalItems = v2Items.length || hotItems.length;
// 高价值数统一从 V4 数据计算（10分制 >= 7），与首页口径一致
// 注意：import() 内不能写 (v4Date || today) 这类复杂表达式，
// Vite 构建期无法静态分析会导致导入静默失败（被 .catch 吞掉后计数为 0）。
// 先算好日期字符串再用模板字面量 —— 与本页 v2 导入、首页 v4 导入写法一致（均已验证可用）。
let highScoreCount = 0;
try {
  const v4FileDate = v4Date || today;
  const v4Mod = await import(`../../data/v4/daily-${v4FileDate}.json`).catch(() => null);
  const v4d = v4Mod?.default;
  if (v4d?.by_category) {
    for (const cat of Object.values(v4d.by_category)) {
      for (const it of (cat as any[])) {
        if ((it.score || 0) >= 7) highScoreCount++;
      }
    }
  }
} catch {}
const recentDates = allDates.slice(0, 10);

// 日期统一：优先 v4，fallback v2
const date = v4Date || v2Data?.date || today;
const year = date.slice(0, 4);
const month = parseInt(date.slice(5, 7)).toString();
const day = parseInt(date.slice(8, 10)).toString();
const displayDate = `${year}年${month}月${day}日`;

function changeClass(change: number | null | undefined): string {
  if (change === null || change === undefined) return 'stable';
  if (change > 50) return 'explosive';
  if (change > 0) return 'rising';
  if (change < -20) return 'falling';
  return 'stable';
}
function changeLabel(change: number | null | undefined): string {
  if (change === null || change === undefined) return '—';
  if (change > 50) return '爆';
  if (change > 0) return `↑${change.toFixed(0)}%`;
  if (change < -20) return `↓${Math.abs(change).toFixed(0)}%`;
  return '—';
}
function sparklinePath(history: Array<{ source_count: number }>): string {
  if (!history || history.length === 0) return '';
  const max = Math.max(...history.map(p => p.source_count), 1);
  const w = 60, hh = 24, pad = 2;
  const step = (w - pad * 2) / Math.max(history.length - 1, 1);
  const points = history.map((p, i) => {
    const x = pad + i * step;
    const y = hh - pad - (p.source_count / max) * (hh - pad * 2);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  return `M${points.join(' L')}`;
}

// 获取平台标签
function getPlatform(item: any): string {
  if (item.platform_label) return item.platform_label;
  if (item.source && typeof item.source === 'object') return item.source.name || item.source.id;
  if (typeof item.source === 'string') return item.source;
  return '';
}

// 获取摘要
function getSummary(item: any): string {
  return item.desc || item.clean_summary || item.title || '';
}
---

<BaseLayout title={`${displayDate} 热点榜`} description={`${displayDate} AI/科技情报热度排行`} lang="zh-CN">
<style>
  :root {
    --bg: #faf9f6; --ink: #202a30; --ink-2: #303c42; --ink-3: #59656b; --ink-4: #657176;
    --accent: #c73e3a; --surface: #fff; --border: #d4d0c8; --paper: #f5f3ee; --line: #e0dcd4;
    --accent-soft: rgba(199,62,58,.08);
  }
  [data-theme="dark"] {
    --bg: #13191c; --ink: #e7eceb; --ink-2: #c8d0cf; --ink-3: #8a9a9a; --ink-4: #6a7a7a;
    --accent: #e85d59; --surface: #1a2227; --border: #2a3539; --paper: #171e22; --line: #252e33;
    --accent-soft: rgba(232,93,89,.08);
  }
  body { background: var(--bg); color: var(--ink); font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif; line-height: 1.6; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .page-wrap { max-width: 100%; margin: 0; padding: 0; }
  .stats-bar { display: flex; align-items: center; justify-content: center; gap: 0; padding: 14px 20px; margin: 20px 0 28px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; font-size: 13px; }
  .stats-bar-item { text-align: center; padding: 0 24px; }
  .stats-bar-value { display: block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 1.3em; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
  .stats-bar-label { display: block; font-size: 0.85em; color: var(--ink-3); margin-top: 2px; }
  .stats-bar-item.highlight .stats-bar-value { color: var(--accent); }
  .stats-bar-divider { width: 1px; height: 28px; background: var(--border); }
  /* AI 评分徽标 */
  .ai-score-badge { display: inline-flex; align-items: center; padding: 1px 6px; border-radius: 4px; font-size: 10px; font-weight: 700; border: 1px solid var(--border); background: var(--accent-soft); color: var(--accent); margin-left: 4px; }

  /* 热点榜卡片 */
  .hot-list { display: flex; flex-direction: column; gap: 16px; }
  .hot-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    transition: box-shadow 0.15s;
  }
  .hot-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.08); }
  .hot-card-top { display: flex; align-items: flex-start; gap: 12px; }
  .hot-rank {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 24px; font-weight: 800; color: var(--ink-4);
    min-width: 32px; text-align: center; line-height: 1;
  }
  .hot-rank.top3 { color: var(--accent); }
  .hot-content { flex: 1; min-width: 0; }
  .hot-title {
    font-size: 15px; font-weight: 700; color: var(--ink);
    line-height: 1.4; margin-bottom: 4px;
    display: block; text-decoration: none;
  }
  .hot-title:hover { color: var(--accent); }
  .hot-summary {
    font-size: 12px; color: var(--ink-3); line-height: 1.6;
    margin-bottom: 8px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .hot-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .hot-source { font-size: 11px; color: var(--ink-4); }
  .hot-cat {
    font-size: 10px; padding: 1px 6px; border-radius: 3px;
    background: var(--accent-soft); color: var(--accent);
    border: 1px solid rgba(199,62,58,0.2);
  }
  .hot-stats {
    display: flex; align-items: center; gap: 12px;
    margin-left: auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .hot-heat {
    font-size: 18px; font-weight: 800; color: var(--ink);
  }
  .hot-heat-label { font-size: 10px; color: var(--ink-4); }
  .hot-change {
    font-size: 11px; font-weight: 700; padding: 2px 6px;
    border-radius: 4px;
  }
  .hot-change.explosive { background: rgba(239,68,68,.1); color: #dc2626; }
  .hot-change.rising   { background: rgba(245,158,11,.1); color: #d97706; }
  .hot-change.falling  { background: rgba(107,114,128,.1); color: #6b7280; }
  .hot-change.stable   { background: var(--paper); color: var(--ink-4); }
  /* 展开来源 */
  .src-expand { display: inline; font-size: 11px; }
  .src-expand summary { cursor: pointer; color: var(--accent); list-style: none; }
  .src-expand summary::-webkit-details-marker { display: none; }
  .src-list { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
  .src-item { padding: 2px 8px; border-radius: 4px; background: var(--accent-soft); color: var(--accent); font-size: 10px; }
  .hot-sparkline {
    width: 60px; height: 24px;
  }
  .hot-sparkline svg { width: 100%; height: 100%; }
  .hot-sparkline path {
    fill: none; stroke: var(--accent); stroke-width: 1.5;
    stroke-linecap: round; stroke-linejoin: round;
  }

  /* 状态标签 */
  .hot-badge {
    display: inline-block;
    font-size: 10px; font-weight: 700; padding: 1px 5px;
    border-radius: 3px; margin-left: 4px;
  }
  .hot-badge.explosive { background: rgba(239,68,68,.15); color: #dc2626; }
  .hot-badge.rising   { background: rgba(245,158,11,.15); color: #d97706; }
  .hot-badge.new      { background: rgba(23,107,117,.15); color: var(--accent); }

  /* 移动端 */
  @media (max-width: 640px) {
    .page-wrap { padding: 0 14px 40px; }
    .hot-card { padding: 12px; }
    .hot-rank { font-size: 20px; min-width: 28px; }
    .hot-title { font-size: 14px; }
    .hot-stats { gap: 8px; }
    .hot-heat { font-size: 16px; }
  }
</style>

<div class="page-wrap">
  <div class="shell">
    <div class="shell-main">
      <Header mode="hot" date={date} totalItems={hotItems.length} today={today} />
      <h1 style={{fontSize:'1.05em',fontWeight:700,color:'var(--ink)',margin:'16px 0',letterSpacing:'-.3px'}}>{displayDate} · 热点榜</h1>
      <div class="stats-bar">
        <div class="stats-bar-item"><span class="stats-bar-value">{totalItems}</span><span class="stats-bar-label">今日情报</span></div>
        <div class="stats-bar-divider"></div>
        <div class="stats-bar-item"><span class="stats-bar-value">{[...new Set(v2Items.map((i: any) => { const s = i.source; return (typeof s === 'object' && s) ? (s.name || s.id || '') : (s || '') }).filter(Boolean))].length}</span><span class="stats-bar-label">采集源</span></div>
        <div class="stats-bar-divider"></div>
        <div class="stats-bar-item highlight"><span class="stats-bar-value">{highScoreCount}</span><span class="stats-bar-label">高价值信号</span></div>
      </div>

      <div class="hot-list">
        {sortedItems.slice(0, 10).map((item: any, idx: number) => {
          const rank = idx + 1;
          const src = item.source_count || 1;
          const change = item.heat_change_6h || null;
          const history = item.heat_history || [];
          const path = sparklinePath(history);
          const platform = getPlatform(item);
          const summary = getSummary(item);
          const cat = item.category || '';
          // 状态标签：只有真涨超50%才显示"爆"，新事件显示"新"
          const badges = [];
          if (change !== null && change > 50) badges.push('<span class="hot-badge explosive">爆</span>');
          else if (change !== null && change > 0) badges.push('<span class="hot-badge rising">↑</span>');
          // 新事件：heat_change_6h 为 null（无历史）且 first_seen_at 在 6h 内
          const firstSeen = item.first_seen_at;
          const isNew = (change === null || change === undefined) && firstSeen;
          if (isNew) badges.push('<span class="hot-badge new">新</span>');
          const badgeHtml = badges.join('');
          return (
            <div class="hot-card">
              <div class="hot-card-top">
                <div class={`hot-rank ${rank <= 3 ? 'top3' : ''}`}>{rank}</div>
                <div class="hot-content">
                  <a href={item.url || '#'} target="_blank" rel="noopener" class="hot-title">{item.title || item.headline || ''}</a>
                  {summary && summary.length > 10 && <p class="hot-summary">{summary.slice(0, 120)}{summary.length > 120 ? '…' : ''}</p>}
                  <div class="hot-meta">
                    <span class="hot-source">{platform}</span>
                    {cat && <span class="hot-cat">{cat}</span>}
                    {(item.score?.total || 0) > 0 && <span class="ai-score-badge">AI 评分 {(item.score?.total || 0)}</span>}
                    {badgeHtml && <span set:html={badgeHtml} />}
                    <div class="hot-stats">
                      <div>
                        {item.sources && item.sources.length > 0 ? (
                          <details class="src-expand">
                            <summary>🔥 {src}家报道</summary>
                            <div class="src-list">
                              {item.sources.map((s: string, si: number) => (
                                <span class="src-item" key={si}>{s}</span>
                              ))}
                            </div>
                          </details>
                        ) : (
                          <span class="hot-heat">🔥 {src}家报道</span>
                        )}
                      </div>
                      <span class={`hot-change ${changeClass(change)}`}>{changeLabel(change)}</span>
                      {path && (
                        <div class="hot-sparkline">
                          <svg viewBox="0 0 60 24" preserveAspectRatio="none">
                            <path d={path} />
                          </svg>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
    
    <aside class="shell-right">
      {allDates.length > 0 && <section style={{marginTop:'32px'}}><CalendarWidget dates={allDates} basePath="/day/" locale="zh" /></section>}
    </aside>
</div>
  <Footer />
</div>
</BaseLayout>
