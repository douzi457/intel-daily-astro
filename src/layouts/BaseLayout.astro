---
import '../styles/global.css';
/* 全站 token 在 global.css 之后引入，后引入的同名变量获胜 */
import '../styles/tokens.css';
import { SITE } from '../lib/constants';

interface Props {
  title: string;
  lang?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  structuredData?: string;
  prevUrl?: string;
  nextUrl?: string;
}

const {
  title, lang = 'zh-CN',
  description = SITE.description,
  ogImage = '/icon.svg',
  canonicalUrl,
  structuredData,
  prevUrl,
  nextUrl,
} = Astro.props;

const isEn = lang.startsWith('en');
const siteDescription = description || (isEn ? SITE.descriptionEn : SITE.description);
const fullTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;
const pageUrl = canonicalUrl || Astro.url.href;

const defaultSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: SITE.nameEn,
  url: SITE.url,
  description: SITE.description,
  inLanguage: isEn ? 'en-US' : 'zh-CN',
  dateModified: new Date().toISOString().split('T')[0],
  datePublished: '2026-01-01',
});
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>

  <!-- SEO Meta -->
  <meta name="description" content={siteDescription} />
  <link rel="canonical" href={pageUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={siteDescription} />
  <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={isEn ? 'en_US' : 'zh_CN'} />

  <!-- Prev/Next for paginated content -->
  {prevUrl && <link rel="prev" href={prevUrl} />}
  {nextUrl && <link rel="next" href={nextUrl} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={siteDescription} />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={structuredData || defaultSchema}></script>

  <!-- Assets -->
  <link rel="icon" type="image/svg+xml" href="/icon.svg" />

  <!-- Geist 字体（jsdelivr 上的 fontsource CSS；加载失败自动回落系统字体） -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-sans@5/400.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-sans@5/500.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-sans@5/600.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-sans@5/700.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-mono@5/400.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-mono@5/500.css" />
  <link rel="preload" href="/Baloo2-Bold.subset.ttf" as="font" type="font/ttf" crossorigin>

  <!-- Cloudflare Web Analytics -->
  <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "ad58971b03c54dab95ef71e841966a34"}'></script>
</head>
<body>
  <a class="skip-link" href="#main">跳到主要内容</a>
  <slot />
  <script>
    // Theme system
    (function() {
      const theme = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);

      const themeBtn = document.getElementById('themeToggle');
      if (themeBtn) {
        themeBtn.textContent = theme === 'dark' ? '☀️' : '🌙';
        themeBtn.addEventListener('click', () => {
          const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
          themeBtn.textContent = next === 'dark' ? '☀️' : '🌙';
        });
      }
    })();
  </script>
  <script>
    // 无障碍：给主内容区挂 id，供“跳到主要内容”链接定位（各页 .shell-main 是主内容区）
    document.querySelector('.shell-main')?.setAttribute('id', 'main');
    // 收藏（localStorage，key daily-saved-v1）+ 键盘快捷键（全站）
    (function () {
      const FAV_KEY = 'daily-saved-v1';
      const FAV_MAX = 200;
      function loadFavs() { try { return JSON.parse(localStorage.getItem(FAV_KEY) || '[]'); } catch { return []; } }
      function saveFavs(list) { try { localStorage.setItem(FAV_KEY, JSON.stringify(list.slice(0, FAV_MAX))); } catch {} }
      function isFav(id) { return loadFavs().some(f => f.id === id); }
      function refreshFavButtons(root) {
        (root || document).querySelectorAll('.fav-btn').forEach(btn => {
          const saved = isFav(btn.dataset.favId || '');
          btn.classList.toggle('saved', saved);
          btn.textContent = saved ? '★' : '☆';
          btn.setAttribute('aria-label', saved ? '取消收藏' : '收藏');
        });
      }
      window.__dailyFavRefresh = refreshFavButtons;
      // 事件委托：服务端渲染与后续动态拼上的按钮都走这里，不用重复绑
      document.addEventListener('click', (e) => {
        const btn = e.target.closest ? e.target.closest('.fav-btn') : null;
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        const id = btn.dataset.favId || '';
        if (!id) return;
        let list = loadFavs();
        if (list.some(f => f.id === id)) {
          list = list.filter(f => f.id !== id);
        } else {
          list.unshift({ id, t: btn.dataset.favTitle || '', d: btn.dataset.favDate || '', u: btn.dataset.favUrl || '', s: Number(btn.dataset.favScore || 0) });
        }
        saveFavs(list);
        refreshFavButtons();
      });
      refreshFavButtons();

      // 快捷键：/ 搜索，j/k 移动条目，Enter/o 打开当前条目
      let kbdIdx = -1;
      function visibleEntries() {
        return Array.from(document.querySelectorAll('.entry-item, .news-item'))
          .filter(el => el.offsetParent !== null);
      }
      function focusEntry(i) {
        const list = visibleEntries();
        if (!list.length) return;
        kbdIdx = Math.max(0, Math.min(i, list.length - 1));
        list.forEach(el => el.classList.remove('kbd-focus'));
        const el = list[kbdIdx];
        el.classList.add('kbd-focus');
        el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      document.addEventListener('keydown', (e) => {
        const t = e.target;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key === '/') {
          const home = document.getElementById('homeSearch');
          if (home) { e.preventDefault(); home.focus(); }
          else { location.href = '/search/'; }
        } else if (e.key === 'j') { focusEntry(kbdIdx + 1); }
        else if (e.key === 'k') { focusEntry(kbdIdx - 1); }
        else if (e.key === 'Enter' || e.key === 'o') {
          const list = visibleEntries();
          const el = list[kbdIdx];
          const a = el ? el.querySelector('a.entry-title, a.news-title') : null;
          if (a && a.href) window.open(a.href, '_blank', 'noopener');
        }
      });
    })();
  </script>
</body>
</html>
