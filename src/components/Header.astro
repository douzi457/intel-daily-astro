---
 // 共享页头（v5，2026-11-20）：品牌与导航已移到顶栏（SiteNav），
// 这里只留页内信息：返回链接、日报日期、条目数。首页不用它。

interface Props {
  mode?: 'home' | 'day' | 'archive' | 'stats' | 'en-home' | 'en-day' | 'hot' | 'officer' | 'new-terms';
  date?: string;
  totalItems?: number;
  lang?: string;
  today?: string;
}

const { mode = 'home', date, totalItems = 0, lang = 'zh-CN', today = '' } = Astro.props;
const isEn = mode.startsWith('en-') || lang.startsWith('en');

// 根据模式生成返回链接
const backLink = (() => {
  switch (mode) {
    case 'day': return '/';
    case 'archive': return '/';
    case 'stats': return '/';
    case 'en-day': return '/en/';
    default: return '';
  }
})();

const backLabel = (() => {
  switch (mode) {
    case 'day': return '← 返回首页';
    case 'archive': return '← 首页';
    case 'stats': return '← 首页';
    case 'en-day': return '← Home';
    default: return '';
  }
})();
---

{(backLink || date || totalItems > 0) && (
  <div class="page-subhead">
    {backLink && <a href={backLink} class="back-link">{backLabel}</a>}
    {date && <span class="subhead-date">{isEn ? 'Report · ' : '日报 · '}{date}</span>}
    {totalItems > 0 && <span class="count-badge">{totalItems} {isEn ? 'items' : '条情报'}</span>}
  </div>
)}

<style>
.page-subhead {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: var(--spacing-4, 16px);
  font-size: 13px;
  color: var(--text-m);
}
.back-link {
  color: var(--text-p);
  text-decoration: none;
  font-weight: 600;
}
.back-link:hover { color: var(--accent); }
.subhead-date { font-weight: 600; color: var(--text-p); }
.count-badge {
  display: inline-flex;
  align-items: center;
  height: 28px;
  font-size: 12px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-full, 9999px);
  padding: 0 12px;
  font-weight: 600;
  color: var(--text-p);
  white-space: nowrap;
}
</style>
