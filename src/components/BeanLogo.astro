---
// BeanLogo：豆子实验室 Logo（内联 SVG，主题感知）
// 豆子 + 信号波 + 两叶芽；填充走 --accent、波形镂空走 --bg，浅/深色自动适配。
// 加载动画：信号波 600ms 描画、芽叶淡入；同一天内只播一次（sessionStorage 记日期），
// prefers-reduced-motion 时关闭。
interface Props { size?: number }
const { size = 28 } = Astro.props;
---

<svg class="bean-logo" width={size} height={size} viewBox="0 0 32 32" role="img" aria-label="豆子实验室">
  <path class="bean-body" d="M18.6 4.2 C24.5 5.6 28 10.8 27.4 16.6 C26.8 22.6 22.2 27.2 16.2 27.8 C10.2 28.4 5 24.6 3.8 18.8 C2.6 13 5.2 7.2 10.4 4.9 C13 3.7 16 3.5 18.6 4.2 Z" fill="var(--accent)"/>
  <path class="bean-wave" d="M8.2 20.8 C10.8 17.2 13.2 18.6 15.4 15.2 C17.4 12 20 12.8 22.8 9.6" fill="none" stroke="var(--bg)" stroke-width="2" stroke-linecap="round"/>
  <path class="bean-leaf" d="M19.5 4.5 C20 1.5 22.5 0.5 24.5 1.5 C23.5 3.8 21 5 19.5 4.5 Z" fill="var(--accent)"/>
  <path class="bean-leaf" d="M19.5 4.5 C18 1.8 15.5 1.2 13.8 2.8 C15.2 4.8 17.8 5.5 19.5 4.5 Z" fill="var(--accent)"/>
</svg>

<style>
.bean-logo { flex-shrink: 0; display: block; }
.bean-logo .bean-wave { stroke-dasharray: 32; stroke-dashoffset: 32; animation: bean-draw .6s ease .1s forwards; }
.bean-logo .bean-leaf { opacity: 0; animation: bean-fade .4s ease .5s forwards; }
.bean-logo.bean-anim-done .bean-wave { stroke-dashoffset: 0; animation: none; }
.bean-logo.bean-anim-done .bean-leaf { opacity: 1; animation: none; }
@keyframes bean-draw { to { stroke-dashoffset: 0; } }
@keyframes bean-fade { to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) {
  .bean-logo .bean-wave, .bean-logo .bean-leaf { animation: none; stroke-dashoffset: 0; opacity: 1; }
}
</style>

<script>
  (function () {
    var el = document.querySelector('.bean-logo');
    if (!el) return;
    var d = new Date();
    var today = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
    try {
      if (sessionStorage.getItem('bean-anim') === today) el.classList.add('bean-anim-done');
      else sessionStorage.setItem('bean-anim', today);
    } catch (e) { el.classList.add('bean-anim-done'); }
  })();
</script>
