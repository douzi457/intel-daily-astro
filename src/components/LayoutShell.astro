---
// ── LayoutShell: 多栏布局壳 ────────────────────────────────────────────────────
// 注意：此组件不接收子元素，直接由各页面内联使用 shell shell-main shell-right 类
---

<div class="shell" client:load>
  <div class="shell-main">
    <slot />
  </div>
</div>

<style>
  .shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }
  .shell-main { min-width: 0; }
  .shell-right { display: none; }

  @media (min-width: 1280px) {
    .shell {
      grid-template-columns: 2fr 1fr;
      gap: 24px;
      padding: 0 24px 60px;
    }
    .shell-main { min-width: 0; }
    .shell-right {
      display: block;
      position: sticky;
      top: 80px;
      max-height: calc(100vh - 96px);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--border, #d4d0c8) transparent;
    }
    .shell-right::-webkit-scrollbar { width: 4px; }
    .shell-right::-webkit-scrollbar-track { background: transparent; }
    .shell-right::-webkit-scrollbar-thumb { background: var(--border, #d4d0c8); border-radius: 2px; }
  }

  @media (min-width: 768px) and (max-width: 1279px) {
    .shell { grid-template-columns: 1fr; gap: 24px; }
    .shell-right {
      display: block;
      order: 2;
      border-top: 1px solid var(--border, #e0dcd4);
      padding-top: 24px;
      margin-top: 24px;
    }
  }

  @media (max-width: 767px) {
    .shell { padding: 0 14px 40px; }
    .shell-right { display: block; order: 2; }
  }
</style>
