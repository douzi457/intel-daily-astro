---
// ScoreExplainer：评分解释弹窗（全站共用，挂在 BaseLayout 里）
// 点任意分数（[data-score-btn]）弹出：分数 + 档位 + 打分口径 + 校准刻度。
// 诚实口径：只解释已有数据——ai_score 是五轴加权（sig/nov/cred/reson/act），
// 但每条只存了一个总分，没有存五轴各自的数值，所以弹窗里不画五轴分值条，
// 只列五轴定义与校准刻度；score 是规则打分，列规则构成。分数是排序依据，不是准确率。
---

<div class="score-pop" id="scorePop" role="dialog" aria-modal="false" aria-label="评分说明" hidden>
  <div class="score-pop-head">
    <span class="score-pop-num" id="scorePopNum">–</span>
    <span class="score-pop-tier" id="scorePopTier"></span>
    <button type="button" class="score-pop-close" id="scorePopClose" aria-label="关闭评分说明">✕</button>
  </div>
  <p class="score-pop-kind" id="scorePopKind"></p>
  <div class="score-pop-axes" id="scorePopAxes">
    <h4>五轴加权（ai_score）</h4>
    <ul>
      <li><b>实质份量</b>：这件事本身有多重</li>
      <li><b>信息增量</b>：比已知信息新多少</li>
      <li><b>证据强度</b>：出处与数据是否扎实</li>
      <li><b>共振面</b>：影响多少人、多少公司</li>
      <li><b>可用性</b>：读者能不能据此行动</li>
    </ul>
    <p class="score-pop-note">五轴各 0–10，按内容类型加权后除以 10；只在有 AI 摘要的条目上有值。</p>
  </div>
  <div class="score-pop-axes" id="scorePopRules" hidden>
    <h4>规则打分（score）</h4>
    <ul>
      <li><b>类别基线</b>：AI/Frontier 6.0、中文科技 5.5 等</li>
      <li><b>关键词</b>：命中科技关键词加分（封顶）</li>
      <li><b>热度</b>：按热度分档加分</li>
      <li><b>优质来源</b>：一线来源 +1</li>
      <li><b>多源</b>：每多一家独立来源 +0.4（封顶 1.2）</li>
    </ul>
  </div>
  <div class="score-pop-scale">
    <h4>刻度校准</h4>
    <ul>
      <li><b>9.5+</b> 当天最重磅（每天 1–2 条）</li>
      <li><b>9.0–9.4</b> 真正的大事</li>
      <li><b>7.5–8.9</b> 重要的新能力 / 产品 / 研究</li>
      <li><b>6.5–7.4</b> 一般资讯</li>
      <li><b>&lt; 6.5</b> 只有明显水的内容</li>
    </ul>
  </div>
  <p class="score-pop-foot">分数是排序依据，不是准确率；没有实际人工核验，不写「已核实」。完整口径见 <a href="/about/#scoring">编辑与评分说明</a>。</p>
</div>

<style>
.score-pop {
  position: fixed; z-index: 400; width: min(320px, calc(100vw - 32px)); max-height: min(80vh, 560px);
  overflow-y: auto; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg); padding: 16px; font-size: 13px; line-height: 1.6; color: var(--text-p);
}
.score-pop-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 6px; }
.score-pop-num { font-family: var(--font-mono); font-size: 32px; font-weight: 800; line-height: 1; color: var(--accent); font-variant-numeric: tabular-nums; }
.score-pop-num.is-god { color: var(--color-signal-gold); }
.score-pop-tier { font-weight: 700; color: var(--text-h); }
.score-pop-close { margin-left: auto; width: 32px; height: 32px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-card); color: var(--text-m); cursor: pointer; font-size: 13px; flex-shrink: 0; }
.score-pop-close:hover { border-color: var(--accent); color: var(--accent); }
.score-pop-kind { margin: 0 0 10px; }
.score-pop-axes h4, .score-pop-scale h4 { font-size: 12px; font-weight: 700; color: var(--text-h); margin: 10px 0 4px; }
.score-pop-axes ul, .score-pop-scale ul { margin: 0; padding-left: 16px; }
.score-pop-axes li, .score-pop-scale li { margin: 2px 0; }
.score-pop-axes li b, .score-pop-scale li b { color: var(--text-h); }
.score-pop-note { margin: 6px 0 0; font-size: 12px; color: var(--text-m); }
.score-pop-foot { margin: 12px 0 0; padding-top: 10px; border-top: 1px solid var(--border); font-size: 12px; color: var(--text-m); }
.score-pop-foot a { color: var(--accent); text-decoration: none; font-weight: 600; }
</style>

<script>
  (function () {
    var pop = document.getElementById('scorePop');
    if (!pop) return;
    var num = document.getElementById('scorePopNum');
    var tier = document.getElementById('scorePopTier');
    var kind = document.getElementById('scorePopKind');
    var axes = document.getElementById('scorePopAxes');
    var rules = document.getElementById('scorePopRules');
    var closeBtn = document.getElementById('scorePopClose');
    var lastTrigger = null;
    function tierOf(s) {
      if (s >= 9.5) return '神级信号';
      if (s >= 9.0) return '大事';
      if (s >= 7.5) return '重要新能力 / 产品 / 研究';
      if (s >= 6.5) return '一般资讯';
      return '水文 / 例行动态';
    }
    function openPop(btn) {
      var s = parseFloat(btn.getAttribute('data-score') || '0');
      var isAi = btn.getAttribute('data-ai') === '1';
      num.textContent = isNaN(s) ? '–' : s.toFixed(1);
      num.classList.toggle('is-god', !isNaN(s) && s >= 9.5);
      tier.textContent = isNaN(s) ? '' : tierOf(s);
      kind.textContent = isAi
        ? 'AI 评分 ai_score：LLM 按五轴加权打出，只在有 AI 摘要的条目上有值。'
        : '信号分 score：规则打分，全部条目都有。';
      axes.hidden = !isAi;
      rules.hidden = isAi;
      pop.hidden = false;
      var r = btn.getBoundingClientRect();
      var pw = pop.offsetWidth, ph = pop.offsetHeight;
      var x = Math.max(8, Math.min(r.left, window.innerWidth - pw - 8));
      var y = r.bottom + 8;
      if (y + ph > window.innerHeight - 8) y = Math.max(8, r.top - ph - 8);
      pop.style.left = x + 'px';
      pop.style.top = y + 'px';
      lastTrigger = btn;
      closeBtn.focus();
    }
    function closePop() {
      pop.hidden = true;
      if (lastTrigger) lastTrigger.focus();
      lastTrigger = null;
    }
    document.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('[data-score-btn]') : null;
      if (btn) { e.preventDefault(); openPop(btn); return; }
      if (!pop.hidden && !pop.contains(e.target)) closePop();
    });
    closeBtn.addEventListener('click', closePop);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !pop.hidden) closePop();
    });
  })();
</script>
